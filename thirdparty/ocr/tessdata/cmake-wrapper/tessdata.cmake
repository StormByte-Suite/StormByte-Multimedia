# tessdata.cmake — #embed, one TU per language (wrapper)
include_guard(GLOBAL)

if(NOT DEFINED TESSDATA_NAMESPACE)
	message(FATAL_ERROR "[tessdata] TESSDATA_NAMESPACE must be defined")
endif()

if(NOT DEFINED TESSDATA_FUNCTION_NAME)
	set(TESSDATA_FUNCTION_NAME "blob")
endif()

if(NOT DEFINED TESSDATA_DIR)
	set(TESSDATA_DIR "${CMAKE_CURRENT_LIST_DIR}/src")
endif()

if(NOT DEFINED GENERATED_TESSDATA_DIR)
	set(GENERATED_TESSDATA_DIR "${CMAKE_CURRENT_BINARY_DIR}/tessdata")
endif()

if(DEFINED TESSDATA_LANGUAGES)
	set(TESSDATA_FILES "")
	foreach(language IN LISTS TESSDATA_LANGUAGES)
		set(model "${TESSDATA_DIR}/${language}.traineddata")
		if(NOT EXISTS "${model}")
			message(FATAL_ERROR "[tessdata] Selected language model is missing: ${model}")
		endif()
		list(APPEND TESSDATA_FILES "${model}")
		set(vertical "${TESSDATA_DIR}/${language}_vert.traineddata")
		if(EXISTS "${vertical}")
			list(APPEND TESSDATA_FILES "${vertical}")
		endif()
	endforeach()
	list(REMOVE_DUPLICATES TESSDATA_FILES)
else()
	file(GLOB TESSDATA_FILES CONFIGURE_DEPENDS "${TESSDATA_DIR}/*.traineddata")
endif()

if(NOT TESSDATA_FILES)
	message(WARNING "[tessdata] No .traineddata files found in \"${TESSDATA_DIR}\"")
	return()
endif()

list(LENGTH TESSDATA_FILES _count)
if(DEFINED TESSDATA_LANGUAGES)
	set(_base_languages ${TESSDATA_LANGUAGES})
	list(REMOVE_DUPLICATES _base_languages)
	list(LENGTH _base_languages _base_count)
	message(STATUS "[tessdata] Generating ${_count} models for ${_base_count} selected languages (including available vertical variants)")
else()
	message(STATUS "[tessdata] Generating ${_count} installed models")
endif()

file(MAKE_DIRECTORY "${GENERATED_TESSDATA_DIR}")

set(STORMBYTE_TESSDATA_GENERATED_SOURCE "")
set(BLOB_DECLS "")
set(SWITCH_CASES "")

foreach(file IN LISTS TESSDATA_FILES)
	get_filename_component(lang "${file}" NAME_WE)
	string(MAKE_C_IDENTIFIER "${lang}" lang_id)

	file(TO_CMAKE_PATH "${file}" abs_file)
	set(_lang_cxx "${GENERATED_TESSDATA_DIR}/${lang_id}.cxx")

	file(WRITE "${_lang_cxx}"
"// Auto-generated by tessdata.cmake — DO NOT EDIT
#include <cstdint>
#include <span>

namespace ${TESSDATA_NAMESPACE}::detail {

std::span<const std::uint8_t> blob_${lang_id}() noexcept {
	static constexpr std::uint8_t raw[] = {
		#embed \"${abs_file}\"
	};
	return std::span<const std::uint8_t>{raw};
}

}
")

	list(APPEND STORMBYTE_TESSDATA_GENERATED_SOURCE "${_lang_cxx}")

	string(APPEND BLOB_DECLS
		"	std::span<const std::uint8_t> blob_${lang_id}() noexcept;\n")

	string(APPEND SWITCH_CASES
		"			case lang_id(\"${lang}\"):\n"
		"				if (lang == \"${lang}\"sv) return detail::blob_${lang_id}();\n"
		"				break;\n")
endforeach()

set(_catalog "${GENERATED_TESSDATA_DIR}/catalog.cxx")
file(WRITE "${_catalog}"
"// Auto-generated by tessdata.cmake — DO NOT EDIT
#include <tessdata.h>

#include <cstdint>
#include <span>
#include <string_view>

using namespace std::string_view_literals;

namespace ${TESSDATA_NAMESPACE}::detail {
${BLOB_DECLS}}

namespace ${TESSDATA_NAMESPACE} {
	namespace {
		constexpr std::uint32_t lang_id(std::string_view s) noexcept {
			std::uint32_t h = 0;
			for (unsigned char c : s)
				h = h * 131u + c;
			return h;
		}
	}

	std::span<const std::uint8_t> ${TESSDATA_FUNCTION_NAME}(std::string_view lang) {
		switch (lang_id(lang)) {
${SWITCH_CASES}			default:
				break;
		}
		return {};
	}
}
")

list(APPEND STORMBYTE_TESSDATA_GENERATED_SOURCE "${_catalog}")

if(NOT CMAKE_SCRIPT_MODE_FILE)
	set_source_files_properties(${STORMBYTE_TESSDATA_GENERATED_SOURCE} PROPERTIES
		COMPILE_OPTIONS "$<$<OR:$<CXX_COMPILER_ID:Clang>,$<CXX_COMPILER_ID:AppleClang>>:-Wno-c23-extensions>"
	)
endif()
