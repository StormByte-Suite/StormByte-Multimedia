From 7ff04460a7c9fafafa4388f3285ca1a222c74c24 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Sun, 18 Oct 2026 23:30:36 +0000
Subject: [PATCH] avformat/file: call libSystem close on Apple

Apple Clang LTO binds file_close()'s close() to a static function of
the same name in the same link. The descriptor is then used as a
pointer (EXC_BAD_ACCESS at fd+0x38). Renaming the APV parser's close,
as 584c41a4ac did for the FFV1 parser, does not cover every such
symbol that can be pulled into the image. close$NOCANCEL is the
libSystem kernel entry, so the local symbol cannot intercept it.
Other systems keep close().

Signed-off-by: David C. Manuelda <StormByte@gmail.com>
---
 libavformat/file.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/libavformat/file.c b/libavformat/file.c
index 71d30a25c4..dde6537829 100644
--- a/libavformat/file.c
+++ b/libavformat/file.c
@@ -223,10 +223,23 @@ static int fd_dup(URLContext *h, int oldfd)
 }
 #endif
 
+#if defined(__APPLE__)
+/* Apple Clang LTO resolves a call to close() to a static function of the
+   same name elsewhere in the link (libavcodec once had two: the FFV1 parser,
+   renamed in 584c41a4ac, and the APV parser). file_close() then passes the
+   descriptor through as a pointer and the process faults. close$NOCANCEL is
+   libSystem's kernel entry, so that local symbol cannot intercept it. */
+extern int ff_close_nocancel(int fd) __asm("_close$NOCANCEL");
+#endif
+
 static int file_close(URLContext *h)
 {
     FileContext *c = h->priv_data;
+#if defined(__APPLE__)
+    int ret = ff_close_nocancel(c->fd);
+#else
     int ret = close(c->fd);
+#endif
     return (ret == -1) ? AVERROR(errno) : 0;
 }
 
