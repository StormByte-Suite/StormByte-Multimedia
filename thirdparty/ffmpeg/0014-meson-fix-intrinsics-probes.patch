From 7da54f6cfad3afb0c959b507af58d585121adb8e Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Wed, 4 Nov 2026 03:30:00 +0100
Subject: [PATCH] Fix Meson intrinsics probes and NEON sources

The NEON and SSE2 intrinsics probes initialized file-scope variables
with intrinsic calls, which is not a constant initializer, so the
probes always failed and HAVE_INTRINSICS_NEON/SSE2 were disabled.
Evaluate the intrinsics inside a function body as configure does.

Enabling HAVE_INTRINSICS_NEON makes mpegvideo_unquantize.c call
ff_mpv_unquantize_init_neon(), so build the libavcodec/neon sources
when intrinsics_neon is enabled, matching the configure Makefile.
---
 libavcodec/meson.build | 8 +++++++-
 meson.build            | 4 ++--
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/libavcodec/meson.build b/libavcodec/meson.build
index 5dc1a4f..044683e 100644
--- a/libavcodec/meson.build
+++ b/libavcodec/meson.build
@@ -1257,7 +1257,13 @@ subdir('opus')
 subdir('vulkan')
 subdir('vvc')
 
-foreach i : [libavcodec_aac_optional_sources, libavcodec_bsf_optional_sources, libavcodec_hevc_optional_sources, libavcodec_opus_optional_sources, libavcodec_vvc_optional_sources]
+libavcodec_intrinsics_optional_sources = {}
+if conf.get('intrinsics_neon', 0) == 1
+  subdir('neon')
+  libavcodec_intrinsics_optional_sources = libavcodec_neon_optional_sources
+endif
+
+foreach i : [libavcodec_aac_optional_sources, libavcodec_bsf_optional_sources, libavcodec_hevc_optional_sources, libavcodec_opus_optional_sources, libavcodec_vvc_optional_sources, libavcodec_intrinsics_optional_sources]
   foreach k, v: i
     libavcodec_optional_sources += {k: libavcodec_optional_sources.get(k, []) + v}
   endforeach
diff --git a/meson.build b/meson.build
index 670c1e2..fc6f272 100644
--- a/meson.build
+++ b/meson.build
@@ -1950,8 +1950,8 @@ check_compiles = [
   ['v4l2_m2m', ['linux/videodev2.h'], 'int i = V4L2_CAP_VIDEO_M2M_MPLANE | V4L2_CAP_VIDEO_M2M | V4L2_BUF_FLAG_LAST;'],
   ['pragma_deprecated', [], 'int main(void) {_Pragma("GCC diagnostic ignored \"-Wdeprecated-declarations\""); return 0; }'],
   ['const_nan', ['math.h'], 'struct { double d; } static const bar[] = { { NAN } };'],
-  ['intrinsics_neon', ['arm_neon.h'], 'int16x8_t test = vdupq_n_s16(0);'],
-  ['intrinsics_sse2', ['emmintrin.h'], '__m128i test = _mm_setzero_si128();'],
+  ['intrinsics_neon', ['arm_neon.h'], 'int probe(void); int probe(void) { int16x8_t v = vdupq_n_s16(0); return vgetq_lane_s16(v, 0); }'],
+  ['intrinsics_sse2', ['emmintrin.h'], 'int probe(void); int probe(void) { __m128i v = _mm_setzero_si128(); return _mm_cvtsi128_si32(v); }'],
 ]
 
 if get_option('schannel').allowed()
--
2.56.0
