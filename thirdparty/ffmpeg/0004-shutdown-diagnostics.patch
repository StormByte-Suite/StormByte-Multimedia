 static AVMutex mutex = AV_MUTEX_INITIALIZER;
 
+#if defined(_MSC_VER)
+#define STORMBYTE_THREAD_LOCAL __declspec(thread)
+#else
+#define STORMBYTE_THREAD_LOCAL _Thread_local
+#endif
+static STORMBYTE_THREAD_LOCAL void (*shutdown_trace_callback)(void *, const char *);
+static STORMBYTE_THREAD_LOCAL void *shutdown_trace_opaque;
+
+void av_stormbyte_set_shutdown_trace(void (*callback)(void *, const char *), void *opaque)
+{
+    shutdown_trace_callback = callback;
+    shutdown_trace_opaque = opaque;
+}
+
+void av_stormbyte_shutdown_trace(const char *fmt, ...)
+{
+    char message[1024];
+    va_list args;
+    if (!shutdown_trace_callback)
+        return;
+    va_start(args, fmt);
+    vsnprintf(message, sizeof(message), fmt, args);
+    va_end(args);
+    shutdown_trace_callback(shutdown_trace_opaque, message);
+}
+
