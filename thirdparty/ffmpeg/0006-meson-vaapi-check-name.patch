From: "David C. Manuelda" <StormByte@gmail.com>
Date: Sun, 1 Nov 2026 23:08:04 +0100
Subject: [PATCH] Fix Meson VA-API probe argument

---
 meson.build | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/meson.build b/meson.build
index b2898afa9c..a82096b037 100644
--- a/meson.build
+++ b/meson.build
@@ -2982,9 +2982,8 @@ endforeach
 # Manual check for vaapi (must be executed after pkg-config)
 if conf.get('vaapi', 0) == 1
   conf.set10('vaapi_1', cc.links(
-    cpp_cond.format('va/va.h', 'VA_CHECK_VERSION(1, 0, 0)')),
-    name: 'VA-API is v1.0 or higher'
-  )
+    cpp_cond.format('va/va.h', 'VA_CHECK_VERSION(1, 0, 0)'), name: 'VA-API is v1.0 or higher'
+  ))
 endif
 
 x86asm_checks = []
