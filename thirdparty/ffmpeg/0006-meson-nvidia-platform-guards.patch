From 331e33d65d45826704312aaaaf29cc666be5f6e3 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Tue, 13 Oct 2026 16:12:46 +0200
Subject: [PATCH] meson: harden NVIDIA platform and CUDA options

Reject explicit NVENC, NVDEC, and CUVID requests on unsupported targets and keep the final auto-detection pass from re-enabling NVIDIA components there. Make the NVCC feature auto by default so an enabled CUDA SDK can select NVCC when CUDA LLVM was not explicitly enabled, while an explicit disabled setting remains authoritative.
---
 meson.build       | 12 +++++++++++-
 meson_options.txt |  2 +-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index cb49fdfe8d..3210e9f450 100644
--- a/meson.build
+++ b/meson.build
@@ -213,6 +213,14 @@ nvenc_opt = get_option('nvenc').disable_auto_if(not nvidia_codec_supported)
 nvdec_opt = get_option('nvdec').disable_auto_if(not nvidia_codec_supported)
 cuvid_opt = get_option('cuvid').disable_auto_if(not nvidia_codec_supported)
 
+if not nvidia_codec_supported
+  foreach component : ['nvenc', 'nvdec', 'cuvid']
+    if get_option(component).enabled()
+      error('@0@ is not supported on @1@/@2@'.format(component, host_system, cpu))
+    endif
+  endforeach
+endif
+
 if host_system == 'windows'
   common_deps += [cc.find_library('ws2_32')]
 endif
@@ -2587,7 +2595,9 @@ endforeach
 # or they've already passed
 foreach component : external_autodetect_library_list + hwaccel_autodetect_library_list
   opt_name = options_map.get(component, component)
-  if conf.get(component, 1) == 1
+  if ['ffnvcodec', 'nvenc', 'nvdec', 'cuvid'].contains(component) and not nvidia_codec_supported
+    conf.set10(component, false)
+  elif conf.get(component, 1) == 1
     conf.set10(component, get_option(opt_name).allowed())
   endif
 endforeach
diff --git a/meson_options.txt b/meson_options.txt
index c7a7b70f90..79d55073c8 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -110,7 +110,7 @@ option('coreservices', type: 'feature', value: 'auto')
 option('crystalhd', type: 'feature', value: 'auto')
 option('cuda', type: 'feature', value: 'disabled')
 option('cuvid', type: 'feature', value: 'disabled')
-option('ff_cuda_nvcc', type: 'feature', value: 'disabled') # cuda_nvcc in ffmpeg
+option('ff_cuda_nvcc', type: 'feature', value: 'auto') # cuda_nvcc in ffmpeg
 option('ff_cuda_llvm', type: 'feature', value: 'auto') # cuda_llvm in ffmpeg
 option('ff_cuda_sdk', type: 'feature', value: 'auto') # cuda_sdk in ffmpeg
 option('d3d11va', type: 'feature', value: 'auto')
-- 
