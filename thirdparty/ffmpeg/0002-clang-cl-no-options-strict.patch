@@ -796,8 +796,11 @@
 }
 '''
 
-# Treat unrecognized flags as errors on MSVC
-if cc.compiles(cpp_cond.format('windows.h', '_MSC_FULL_VER >= 193030705'))
+# Treat unrecognized flags as errors on MSVC. clang-cl accepts
+# /options:strict, then forwards it to lld-link. lld-link reads /o as
+# /out and tries to write ptions:strict.pdb, so every link probe fails
+# and installed libraries look missing. cl.exe with link.exe does not.
+if cc.get_id() != 'clang-cl' and cc.compiles(cpp_cond.format('windows.h', '_MSC_FULL_VER >= 193030705'))
   project_c_args += cc.get_supported_arguments(['/options:strict'])
 endif
 
