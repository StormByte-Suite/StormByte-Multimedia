+        memcpy(&chunk, &out_tl[y * dst_stride + x - 1], sizeof(chunk));
+        memcpy(&out_tl[y * dst_stride + x], &chunk, sizeof(chunk));
       }
 
       x = 0;
       int16_t sample = kvz_eight_tap_filter_hor_16bit_avx2(ver_fir_t, &col_pos_l[y + off_y_fir_t]) >> shift2;
