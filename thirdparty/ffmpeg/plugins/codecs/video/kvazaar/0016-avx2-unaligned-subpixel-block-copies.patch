       }
 
       x = 0;
       int16_t sample = kvz_eight_tap_filter_hor_16bit_avx2(ver_fir_t, &col_pos_r[y + off_y_fir_t]) >> shift2;
       sample = kvz_fast_clip_16bit_to_pixel((sample + wp_offset1) >> wp_shift1);
