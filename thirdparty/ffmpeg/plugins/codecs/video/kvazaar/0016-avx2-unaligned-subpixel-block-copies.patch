       uint64_t first = sample;
-      uint64_t rest = *(uint64_t*)&out_tl[y * dst_stride + x];
+      uint64_t rest;
+      memcpy(&rest, &out_tl[y * dst_stride + x], sizeof(rest));
       uint64_t chunk = (rest << 8) | first;
-      *(uint64_t*)&out_tl[y * dst_stride + x] = chunk;
+      memcpy(&out_tl[y * dst_stride + x], &chunk, sizeof(chunk));
     }
   }
 
@@ -1080,17 +1095,19 @@ static void kvz_filter_qpel_blocks_diag_luma_avx2(const encoder_control_t * enco
   if (!off_x_fir_r) {
     for (y = 0; y < height; ++y) {
       for (x = width - 8; x >= 8; x -= 8) {
-        uint64_t chunk = *(uint64_t*)&out_tr[y * dst_stride + x - 1];
-        *(uint64_t*)&out_tr[y * dst_stride + x] = chunk;
+        uint64_t chunk;
