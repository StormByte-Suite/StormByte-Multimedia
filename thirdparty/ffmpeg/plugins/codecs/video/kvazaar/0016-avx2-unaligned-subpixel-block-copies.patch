+      memcpy(&out_tr[y * dst_stride + x], &chunk, sizeof(chunk));
     }
   }
 
@@ -1103,17 +1120,19 @@ static void kvz_filter_qpel_blocks_diag_luma_avx2(const encoder_control_t * enco
   if (!off_x_fir_l) {
     for (y = 0; y < height; ++y) {
       for (x = width - 8; x >= 8; x -= 8) {
-        uint64_t chunk = *(uint64_t*)&out_bl[y * dst_stride + x - 1];
-        *(uint64_t*)&out_bl[y * dst_stride + x] = chunk;
+        uint64_t chunk;
+        memcpy(&chunk, &out_bl[y * dst_stride + x - 1], sizeof(chunk));
