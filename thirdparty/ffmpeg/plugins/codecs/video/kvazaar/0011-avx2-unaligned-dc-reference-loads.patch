From 2bc91e0f382a9065d409fb20c2b72e067d4ebb5e Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Mon, 2 Nov 2026 05:26:43 +0100
Subject: [PATCH] avx2: load filtered DC reference edges without scalar
 alignment

The filtered 8x8 DC predictor reads reference edges at a one-byte offset
through uint64_t pointers. These addresses need not be eight-byte
aligned. Load them directly with the unaligned-capable 64-bit SIMD
intrinsic, preserving both the exact read width and the zeroed upper
lanes. Reproduced by the unaligned-video encoding test with UBSan.
---
 src/strategies/avx2/intra-avx2.c | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/src/strategies/avx2/intra-avx2.c b/src/strategies/avx2/intra-avx2.c
index 51537867..2ee67b13 100644
--- a/src/strategies/avx2/intra-avx2.c
+++ b/src/strategies/avx2/intra-avx2.c
@@ -1124,9 +1124,6 @@ static void pred_filtered_dc_8x8(const uint8_t *ref_top,
                                  const uint8_t *ref_left,
                                        uint8_t *out_block)
 {
-  const uint64_t rt_u64 = *(const uint64_t *)(ref_top  + 1);
-  const uint64_t rl_u64 = *(const uint64_t *)(ref_left + 1);
-
   const __m128i zero128 = _mm_setzero_si128();
   const __m256i twos    = _mm256_set1_epi8(2);
 
@@ -1163,8 +1160,8 @@ static void pred_filtered_dc_8x8(const uint8_t *ref_top,
   const __m256i rl_shuf_dn_hi = _mm256_add_epi8 (rl_shuf_dn_lo, twos);
 
   __m128i eight         = _mm_cvtsi32_si128     (8);
-  __m128i rt            = _mm_cvtsi64_si128     (rt_u64);
-  __m128i rl            = _mm_cvtsi64_si128     (rl_u64);
+  __m128i rt            = _mm_loadl_epi64      ((const __m128i *)(ref_top + 1));
+  __m128i rl            = _mm_loadl_epi64      ((const __m128i *)(ref_left + 1));
   __m128i rtrl          = _mm_unpacklo_epi64    (rt, rl);
 
   __m128i sad0          = _mm_sad_epu8          (rtrl, zero128);
@@ -1421,4 +1418,3 @@ int kvz_strategy_register_intra_avx2(void* opaque, uint8_t bitdepth)
 #endif //COMPILE_INTEL_AVX2 && defined X86_64
   return success;
 }
-
