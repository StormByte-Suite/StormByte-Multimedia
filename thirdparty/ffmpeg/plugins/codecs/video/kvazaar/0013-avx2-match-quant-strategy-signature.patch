From f447b2362e00b924aff498c4b0e031d06ae97873 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Mon, 2 Nov 2026 05:34:10 +0100
Subject: [PATCH] avx2: match the quantization strategy function type

The AVX2 quantizer takes const coeff_t input while quant_func and the
generic implementation take coeff_t input. Those function types are
incompatible even though the AVX2 implementation only reads the
coefficients. Match the strategy signature without changing the
implementation or alias restrictions. Reproduced by the existing
unaligned-video test with UBSan function-type checking.
---
 src/strategies/avx2/quant-avx2.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/strategies/avx2/quant-avx2.c b/src/strategies/avx2/quant-avx2.c
index a47ad928..12f1f448 100644
--- a/src/strategies/avx2/quant-avx2.c
+++ b/src/strategies/avx2/quant-avx2.c
@@ -360,7 +360,7 @@ static INLINE int32_t hide_block_sign(__m256i coefs, __m256i q_coefs, __m256i de
  * \brief quantize transformed coefficents
  *
  */
-void kvz_quant_avx2(const encoder_state_t * const state, const coeff_t * __restrict coef, coeff_t * __restrict q_coef, int32_t width,
+void kvz_quant_avx2(const encoder_state_t * const state, coeff_t * __restrict coef, coeff_t * __restrict q_coef, int32_t width,
   int32_t height, int8_t type, int8_t scan_idx, int8_t block_type)
 {
   const encoder_control_t * const encoder = state->encoder_control;
-- 
