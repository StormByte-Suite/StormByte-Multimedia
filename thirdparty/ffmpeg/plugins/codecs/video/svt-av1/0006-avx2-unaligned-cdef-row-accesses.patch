-                               *(uint64_t*)(in + (i + (3 * subsampling_factor)) * CDEF_BSTRIDE - s2o2));
+        p0  = _mm256_set_epi64x(_mm_cvtsi128_si64(xx_loadl_64(in + i * CDEF_BSTRIDE + s1o2)),
+                               _mm_cvtsi128_si64(xx_loadl_64(in + (i + (1 * subsampling_factor)) * CDEF_BSTRIDE + s1o2)),
