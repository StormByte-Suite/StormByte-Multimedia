Reference blocks passed to the 16-wide sub-pixel variance kernels are not
guaranteed to be 16-byte aligned. Every interpolating path already loads
the reference with movu, but the x_offset == 0 && y_offset == 0 path used
mova and faults with an access violation on unaligned pointers.

diff --git a/Source/Lib/ASM_SSE2/subpel_variance_sse2.asm b/Source/Lib/ASM_SSE2/subpel_variance_sse2.asm
--- a/Source/Lib/ASM_SSE2/subpel_variance_sse2.asm
+++ b/Source/Lib/ASM_SSE2/subpel_variance_sse2.asm
@@ -193,7 +193,7 @@
 .x_zero_y_zero_loop:
 %if %1 == 16
   movu                 m0, [srcq]
-  mova                 m1, [dstq]
+  movu                 m1, [dstq]
 %if %2 == 1 ; avg
   pavgb                m0, [secq]
   punpckhbw            m3, m1, m5
diff --git a/Source/Lib/ASM_SSSE3/subpel_variance_ssse3.asm b/Source/Lib/ASM_SSSE3/subpel_variance_ssse3.asm
--- a/Source/Lib/ASM_SSSE3/subpel_variance_ssse3.asm
+++ b/Source/Lib/ASM_SSSE3/subpel_variance_ssse3.asm
@@ -186,7 +186,7 @@
 .x_zero_y_zero_loop:
 %if %1 == 16
   movu                 m0, [srcq]
-  mova                 m1, [dstq]
+  movu                 m1, [dstq]
 %if %2 == 1 ; avg
   pavgb                m0, [secq]
   punpckhbw            m3, m1, m5
