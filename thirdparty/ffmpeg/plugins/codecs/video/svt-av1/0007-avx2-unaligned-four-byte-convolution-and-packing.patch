From 48527d2d1a086010e09e13d3eaceb6df67c85aa9 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Mon, 2 Nov 2026 06:15:51 +0100
Subject: [PATCH] avx2: load four-byte convolution and packing fragments safely

Byte-addressed pixel buffers and the two-tap coefficient pair at filter+3 are not guaranteed to be aligned to int32_t. Use the existing xx_loadl_32 memcpy-based helper instead of typed scalar dereferences throughout the affected convolution and packing paths. Preserve exact four-byte access size and zeroed upper lanes. UBSan reproduced misaligned loads in interleaved video encoding, repeated cancellation and Dolby Vision watermarking.
---
 Source/Lib/ASM_AVX2/convolve_avx2.c           | 38 +++++++++----------
 Source/Lib/ASM_AVX2/convolve_avx2.h           | 38 +++++++++----------
 .../Lib/ASM_AVX2/pic_operators_intrin_avx2.c  | 25 ++++++------
 3 files changed, 51 insertions(+), 50 deletions(-)

diff --git a/Source/Lib/ASM_AVX2/convolve_avx2.c b/Source/Lib/ASM_AVX2/convolve_avx2.c
index d1d51bb6b..e08ea2173 100644
--- a/Source/Lib/ASM_AVX2/convolve_avx2.c
+++ b/Source/Lib/ASM_AVX2/convolve_avx2.c
@@ -78,7 +78,7 @@ void svt_av1_convolve_y_sr_avx2(const uint8_t* src, int32_t src_stride, uint8_t*
                 } else if (w == 4) {
                     __m128i s_32[2];
 
-                    s_32[0] = _mm_cvtsi32_si128(*(int32_t*)src_ptr);
+                    s_32[0] = xx_loadl_32(src_ptr);
 
                     do {
                         const __m128i res = y_convolve_2tap_4x2_ssse3(src_ptr, src_stride, coeffs_128, s_32);
@@ -230,13 +230,13 @@ void svt_av1_convolve_y_sr_avx2(const uint8_t* src, int32_t src_stride, uint8_t*
                 } else if (w == 4) {
                     __m128i s_32[2];
 
-                    s_32[0] = _mm_cvtsi32_si128(*(int32_t*)src_ptr);
+                    s_32[0] = xx_loadl_32(src_ptr);
 
                     do {
-                        s_32[1]          = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + src_stride));
+                        s_32[1]          = xx_loadl_32(src_ptr + src_stride);
                         const __m128i d0 = _mm_avg_epu8(s_32[0], s_32[1]);
                         xx_storel_32(dst, d0);
-                        s_32[0]          = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 2 * src_stride));
+                        s_32[0]          = xx_loadl_32(src_ptr + 2 * src_stride);
                         const __m128i d1 = _mm_avg_epu8(s_32[1], s_32[0]);
                         xx_storel_32(dst + dst_stride, d1);
                         src_ptr += 2 * src_stride;
@@ -375,9 +375,9 @@ void svt_av1_convolve_y_sr_avx2(const uint8_t* src, int32_t src_stride, uint8_t*
 
                 assert(w == 4);
 
-                s_32[0] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 0 * src_stride));
-                s_32[1] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 1 * src_stride));
-                s_32[2] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 2 * src_stride));
+                s_32[0] = xx_loadl_32(src_ptr + 0 * src_stride);
+                s_32[1] = xx_loadl_32(src_ptr + 1 * src_stride);
+                s_32[2] = xx_loadl_32(src_ptr + 2 * src_stride);
 
                 const __m128i src01 = _mm_unpacklo_epi32(s_32[0], s_32[1]);
                 const __m128i src12 = _mm_unpacklo_epi32(s_32[1], s_32[2]);
@@ -522,11 +522,11 @@ void svt_av1_convolve_y_sr_avx2(const uint8_t* src, int32_t src_stride, uint8_t*
 
                 assert(w == 4);
 
-                s_32[0] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 0 * src_stride));
-                s_32[1] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 1 * src_stride));
-                s_32[2] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 2 * src_stride));
-                s_32[3] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 3 * src_stride));
-                s_32[4] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 4 * src_stride));
+                s_32[0] = xx_loadl_32(src_ptr + 0 * src_stride);
+                s_32[1] = xx_loadl_32(src_ptr + 1 * src_stride);
+                s_32[2] = xx_loadl_32(src_ptr + 2 * src_stride);
+                s_32[3] = xx_loadl_32(src_ptr + 3 * src_stride);
+                s_32[4] = xx_loadl_32(src_ptr + 4 * src_stride);
 
                 const __m128i src01 = _mm_unpacklo_epi32(s_32[0], s_32[1]);
                 const __m128i src12 = _mm_unpacklo_epi32(s_32[1], s_32[2]);
@@ -713,13 +713,13 @@ void svt_av1_convolve_y_sr_avx2(const uint8_t* src, int32_t src_stride, uint8_t*
 
                 assert(w == 4);
 
-                s_32[0] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 0 * src_stride));
-                s_32[1] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 1 * src_stride));
-                s_32[2] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 2 * src_stride));
-                s_32[3] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 3 * src_stride));
-                s_32[4] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 4 * src_stride));
-                s_32[5] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 5 * src_stride));
-                s_32[6] = _mm_cvtsi32_si128(*(int32_t*)(src_ptr + 6 * src_stride));
+                s_32[0] = xx_loadl_32(src_ptr + 0 * src_stride);
+                s_32[1] = xx_loadl_32(src_ptr + 1 * src_stride);
+                s_32[2] = xx_loadl_32(src_ptr + 2 * src_stride);
+                s_32[3] = xx_loadl_32(src_ptr + 3 * src_stride);
+                s_32[4] = xx_loadl_32(src_ptr + 4 * src_stride);
+                s_32[5] = xx_loadl_32(src_ptr + 5 * src_stride);
+                s_32[6] = xx_loadl_32(src_ptr + 6 * src_stride);
 
                 const __m128i src01 = _mm_unpacklo_epi32(s_32[0], s_32[1]);
                 const __m128i src12 = _mm_unpacklo_epi32(s_32[1], s_32[2]);
