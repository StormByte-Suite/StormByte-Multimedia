From 690b451e27c3f9903f7ae16484a0ab10135bfd47 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Mon, 2 Nov 2026 05:26:43 +0100
Subject: [PATCH] lookahead: access temporal-filter scratch only when the
 filter is enabled

Lookahead allocates m_metld only when temporal filtering is enabled.
processTasks nevertheless binds a MotionEstimatorTLD reference
unconditionally, reading an uninitialized pointer in ordinary encoding.
Move the array access into the existing temporal-filter branch, which is
its only use. Reproduced by the HEVC output-properties test with UBSan
after correcting bitstream shifts.
---
 source/encoder/slicetype.cpp | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/source/encoder/slicetype.cpp b/source/encoder/slicetype.cpp
index 3ecc641e5..b9724014d 100644
--- a/source/encoder/slicetype.cpp
+++ b/source/encoder/slicetype.cpp
@@ -4083,7 +4083,6 @@ void CostEstimateGroup::processTasks(int workerThreadID)
     if (workerThreadID < 0)
         id = pool ? pool->m_numWorkers : 0;
     LookaheadTLD& tld = m_lookahead.m_tld[id];
-    MotionEstimatorTLD& m_metld = m_lookahead.m_metld[id];
 
     m_lock.acquire();
     while (m_jobAcquired < m_jobTotal)
@@ -4101,7 +4100,7 @@ void CostEstimateGroup::processTasks(int workerThreadID)
 
             if (m_lookahead.m_param->bEnableTemporalFilter && curFrame && (curFrame->m_lowres.sliceType == X265_TYPE_IDR || curFrame->m_lowres.sliceType == X265_TYPE_I || curFrame->m_lowres.sliceType == X265_TYPE_P))
             {
-                estimatelowresmotion(m_metld, curFrame, e.p0);
+                estimatelowresmotion(m_lookahead.m_metld[id], curFrame, e.p0);
             }
             else
                 estimateFrameCost(tld, e.p0, e.p1, e.b, false);
-- 
