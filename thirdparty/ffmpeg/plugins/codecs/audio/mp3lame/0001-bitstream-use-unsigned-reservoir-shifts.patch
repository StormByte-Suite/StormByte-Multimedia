From 95bced3364557a384e996aff138965bcd8d7bf54 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Mon, 2 Nov 2026 04:55:44 +0100
Subject: [PATCH] bitstream: shift the bit reservoir value as unsigned in
 putbits2

putbits2 shifts an int value into a byte-aligned position before storing
the low byte. Valid bit patterns can overflow the signed intermediate,
even though only the low output bits are retained.

Convert val to unsigned before the shifts. This gives defined logical
bit operations while preserving the bits written to the output byte.

Reproduced with UBSan during the existing MP3 tag roundtrip test.
---
 libmp3lame/bitstream.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libmp3lame/bitstream.c b/libmp3lame/bitstream.c
index 0de64e3..e9da8fc 100644
--- a/libmp3lame/bitstream.c
+++ b/libmp3lame/bitstream.c
@@ -178,7 +178,7 @@ putbits2(lame_internal_flags * gfc, int val, int j)
         assert(j < MAX_LENGTH); /* 32 too large on 32 bit machines */
         assert(bs->buf_bit_idx < MAX_LENGTH);
 
-        bs->buf[bs->buf_byte_idx] |= ((val >> j) << bs->buf_bit_idx);
+        bs->buf[bs->buf_byte_idx] |= (((unsigned int)val >> j) << bs->buf_bit_idx);
         bs->totbit += k;
     }
 }
