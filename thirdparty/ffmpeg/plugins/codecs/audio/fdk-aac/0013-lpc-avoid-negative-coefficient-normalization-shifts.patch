From bbe546e2da0c85a7447a998ca418705d5167379d Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Mon, 2 Nov 2026 05:43:01 +0100
Subject: [PATCH] libFDK: normalize signed LPC coefficients without negative
 shifts

Both PARCOR-to-LPC conversions normalize their signed work-buffer
coefficients using a shift bounded by measured headroom. Shift unsigned
bit patterns and restore FIXP_DBL before converting coefficient
precision. Reproduced in the default CLpc_ParcorToLpc overload by stereo
AAC encoding with UBSan; the TNS overload has the same normalization.
---
 libFDK/src/FDK_lpc.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libFDK/src/FDK_lpc.cpp b/libFDK/src/FDK_lpc.cpp
index 7d7e691..892baf6 100644
--- a/libFDK/src/FDK_lpc.cpp
+++ b/libFDK/src/FDK_lpc.cpp
@@ -384,7 +384,7 @@ INT CLpc_ParcorToLpc(const FIXP_LPC_TNS reflCoeff[], FIXP_LPC_TNS LpcCoeff[],
   shiftval = fMin(fNorm(maxVal), par2LpcShiftVal);
 
   for (i = 0; i < numOfCoeff; i++) {
-    LpcCoeff[i] = FX_DBL2FX_LPC_TNS(workBuffer[i] << shiftval);
+    LpcCoeff[i] = FX_DBL2FX_LPC_TNS((FIXP_DBL)((ULONG)workBuffer[i] << shiftval));
   }
 
   return (par2LpcShiftVal - shiftval);
@@ -422,7 +422,7 @@ INT CLpc_ParcorToLpc(const FIXP_LPC reflCoeff[], FIXP_LPC LpcCoeff[],
   shiftval = fMin(fNorm(maxVal), par2LpcShiftVal);
 
   for (i = 0; i < numOfCoeff; i++) {
-    LpcCoeff[i] = FX_DBL2FX_LPC(workBuffer[i] << shiftval);
+    LpcCoeff[i] = FX_DBL2FX_LPC((FIXP_DBL)((ULONG)workBuffer[i] << shiftval));
   }
 
   return (par2LpcShiftVal - shiftval);
-- 
