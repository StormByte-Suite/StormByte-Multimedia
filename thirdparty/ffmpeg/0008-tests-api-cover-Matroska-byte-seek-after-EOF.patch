 fate-api-h264-slice: $(APITESTSDIR)/api-h264-slice-test$(EXESUF)
 fate-api-h264-slice: CMD = run $(APITESTSDIR)/api-h264-slice-test$(EXESUF) 2 $(TARGET_SAMPLES)/h264/crew_cif.nal
 
+FATE_API_SAMPLES_LIBAVFORMAT-$(CONFIG_MATROSKA_DEMUXER) += fate-api-seek-byte-mkv
+fate-api-seek-byte-mkv: $(APITESTSDIR)/api-seek-byte-test$(EXESUF)
+fate-api-seek-byte-mkv: CMD = run $(APITESTSDIR)/api-seek-byte-test$(EXESUF) $(TARGET_SAMPLES)/mkv/lzo.mka
+
 FATE_API_LIBAVFORMAT-yes += $(if $(findstring fate-lavf-flv,$(FATE_LAVF_CONTAINER)),fate-api-seek)
 fate-api-seek: $(APITESTSDIR)/api-seek-test$(EXESUF) fate-lavf-flv
 fate-lavf-flv: KEEP_FILES ?= 1
diff --git a/tests/ref/fate/api-seek-byte-mkv b/tests/ref/fate/api-seek-byte-mkv
new file mode 100644
index 0000000000..918b5be2ac
--- /dev/null
+++ b/tests/ref/fate/api-seek-byte-mkv
@@ -0,0 +1,12 @@
+first pass
+st:0 pts:0 pos:279 size:16384 adler:0x00000000
+st:0 pts:4096 pos:279 size:16384 adler:0xad7eebf4
+st:0 pts:8192 pos:279 size:16384 adler:0x1d1ff9d9
+st:0 pts:12288 pos:279 size:16384 adler:0xf1d9e2e2
+packets:4
+after byte seek to 0
+st:0 pts:0 pos:279 size:16384 adler:0x00000000
+st:0 pts:4096 pos:279 size:16384 adler:0xad7eebf4
+st:0 pts:8192 pos:279 size:16384 adler:0x1d1ff9d9
+st:0 pts:12288 pos:279 size:16384 adler:0xf1d9e2e2
+packets:4
