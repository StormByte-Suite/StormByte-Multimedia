 tests/api/api-seek-byte-test.c   | 77 ++++++++++++++++++++++++++++++++
 tests/fate/api.mak               |  4 ++
 tests/ref/fate/api-seek-byte-mkv | 12 +++++
 4 files changed, 94 insertions(+)
