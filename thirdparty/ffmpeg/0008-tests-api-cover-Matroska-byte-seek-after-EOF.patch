diff --git a/tests/api/api-seek-byte-test.c b/tests/api/api-seek-byte-test.c
new file mode 100644
index 0000000000..b7a4ca42a0
--- /dev/null
+++ b/tests/api/api-seek-byte-test.c
@@ -0,0 +1,77 @@
+/*
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+/**
+ * Read a file to its end, seek back to its first byte with AVSEEK_FLAG_BYTE
+ * and read it again, printing every packet of both passes. A demuxer that
+ * keeps an end of stream across the byte seek prints nothing for the second.
+ */
+
+#include <inttypes.h>
+#include <stdio.h>
+
+#include "libavformat/avformat.h"
+#include "libavutil/adler32.h"
+
+static int read_pass(AVFormatContext *s, AVPacket *pkt, const char *name)
+{
+    int ret, count = 0;
+
+    printf("%s\n", name);
+    while ((ret = av_read_frame(s, pkt)) >= 0) {
+        printf("st:%d pts:%" PRId64 " pos:%" PRId64 " size:%d adler:0x%08"PRIx32"\n",
+               pkt->stream_index, pkt->pts, pkt->pos, pkt->size,
+               av_adler32_update(0, pkt->data, pkt->size));
+        av_packet_unref(pkt);
+        count++;
+    }
+    printf("packets:%d\n", count);
+    return ret == AVERROR_EOF ? 0 : ret;
+}
+
+int main(int argc, char **argv)
+{
+    AVFormatContext *s = NULL;
+    AVPacket *pkt = NULL;
+    int ret;
+
+    if (argc < 2) {
+        fprintf(stderr, "usage: %s <input>\n", argv[0]);
+        return 1;
+    }
+
+    if ((ret = avformat_open_input(&s, argv[1], NULL, NULL)) < 0)
+        return 1;
+    if (!(pkt = av_packet_alloc())) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+
+    if ((ret = read_pass(s, pkt, "first pass")) < 0)
+        goto end;
+    if ((ret = av_seek_frame(s, -1, 0, AVSEEK_FLAG_BYTE)) < 0) {
+        printf("byte seek failed\n");
+        goto end;
+    }
+    ret = read_pass(s, pkt, "after byte seek to 0");
+
+end:
+    av_packet_free(&pkt);
+    avformat_close_input(&s);
+    return ret < 0;
+}
diff --git a/tests/fate/api.mak b/tests/fate/api.mak
