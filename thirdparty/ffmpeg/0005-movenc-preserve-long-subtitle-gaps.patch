 FATE_MOV_FFMPEG_FFPROBE-$(call TRANSCODE, MOVTEXT SRT, MP4 MOV, SRT_DEMUXER NULL_MUXER) += fate-mov-subtitle-long-gap-negative-start
-fate-mov-subtitle-long-gap-negative-start: CMD = transcode srt $(SRC_PATH)/tests/mov-subtitle-long-gap.srt mp4 "-map 0:s -c:s mov_text -time_base:s 1:1000000 -avoid_negative_ts disabled" "-map 0:s -c:s copy" "-show_entries packet=pts,dts:stream=index,codec_name,time_base,start_time,duration_ts,duration -of compact" "" "" "-itsoffset -2" null
+fate-mov-subtitle-long-gap-negative-start: CMD = transcode srt $(SRC_PATH)/tests/mov-subtitle-long-gap.srt mp4 "-map 0:s -c:s mov_text -time_base:s 1:1000000 -avoid_negative_ts disabled" "-map 0:s -c:s copy" "-ignore_editlist 1 -show_entries packet=pts,dts,duration:stream=index,codec_name,time_base,start_time,duration_ts,duration -of compact" "" "" "-itsoffset -2" null
 
