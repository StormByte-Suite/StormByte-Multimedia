From 3aa1311d97986892562bf9d9668aa99a547f61c3 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Fri, 30 Oct 2026 15:19:32 +0100
Subject: [PATCH 1/3] avformat/movenc: preserve long gaps between timed-text
 subtitles

check_pkt() rejects DTS deltas greater than or equal to INT_MAX and
replaces the incoming DTS with the previous sample's DTS plus one,
discarding its PTS. With a 1/1000000 subtitle time base, an empty interval
of 2147.483647 seconds is sufficient to trigger this recovery path.
Sparse mov_text subtitles can therefore appear thousands of seconds
before their intended presentation time.

The empty sample inserted at the end of a cue does not prevent this:
its duration is determined by the next sample, which may be hours later.
The sample-duration helpers also require signed 32-bit durations.

Split long empty intervals by inserting two-byte empty mov_text samples
at steps of INT_MAX - 1 track ticks, preserving cue timestamps, durations,
text and the original timescale. Only split for a packet belonging to
the subtitle track, since intermediate samples triggered by another
track can alter fragment timing. Rescale other tracks' DTS before
comparing timestamps, and ignore packets without a DTS.

Use start_dts plus track_duration as the absolute subtitle end even
after a fragment flush clears entry, and refresh it after each insertion.
Insert the initial end sample at most once per pass; subsequent gap
splits must advance the absolute end or report an error.

Validate packets in consistent timestamp coordinates before and after
applying negative_cts_offsets. Only undo the track's DTS shift when
checking an unshifted packet. Otherwise a valid INT_MAX - 1 split with
a 100-tick shift is rejected on the second check, moves the subtitle end
backward, and causes sustained sample generation.

Add FATE coverage for long gaps, negative starts, fragmented audio with
different track time bases, and the shifted-DTS trigger. Require the null
muxer and the SRT and native-endian PCM decoders where the test commands
use them.

Discovered while testing transcoding fixtures in StormByte-Multimedia
and subsequently reproduced with real-world videos.

Fixes: incorrect mov_text timestamps after long subtitle gaps
Found-by: https://github.com/StormByte-Suite/StormByte-Multimedia
Signed-off-by: David C. Manuelda <StormByte@gmail.com>
---
 libavformat/movenc.c                          | 61 +++++++++++++++----
 tests/fate/mov.mak                            | 12 ++++
 tests/mov-subtitle-audio-fragment.srt         |  3 +
 tests/mov-subtitle-long-gap.srt               |  7 +++
 tests/ref/fate/mov-subtitle-audio-fragment    |  6 ++
 tests/ref/fate/mov-subtitle-long-gap          | 21 +++++++
 .../ref/fate/mov-subtitle-long-gap-dts-shift  |  9 +++
 .../fate/mov-subtitle-long-gap-negative-start |  8 +++
 8 files changed, 116 insertions(+), 11 deletions(-)
 create mode 100644 tests/mov-subtitle-audio-fragment.srt
 create mode 100644 tests/mov-subtitle-long-gap.srt
 create mode 100644 tests/ref/fate/mov-subtitle-audio-fragment
 create mode 100644 tests/ref/fate/mov-subtitle-long-gap
 create mode 100644 tests/ref/fate/mov-subtitle-long-gap-dts-shift
 create mode 100644 tests/ref/fate/mov-subtitle-long-gap-negative-start

diff --git a/libavformat/movenc.c b/libavformat/movenc.c
index debe1acb7e0..da85c298d2c 100644
--- a/libavformat/movenc.c
+++ b/libavformat/movenc.c
@@ -7032,7 +7032,8 @@ static int mov_auto_flush_fragment(AVFormatContext *s, int force)
     return ret;
 }
 
-static int check_pkt(AVFormatContext *s, MOVTrack *trk, AVPacket *pkt)
+static int check_pkt(AVFormatContext *s, MOVTrack *trk, AVPacket *pkt,
+                     int dts_shifted)
 {
     int64_t ref;
     uint64_t duration;
@@ -7045,9 +7046,9 @@ static int check_pkt(AVFormatContext *s, MOVTrack *trk, AVPacket *pkt)
     } else
         ref = pkt->dts; // Skip tests for the first packet
 
-    if (trk->dts_shift != AV_NOPTS_VALUE) {
-        /* With negative CTS offsets we have set an offset to the DTS,
-         * reverse this for the check. */
+    if (!dts_shifted && trk->dts_shift != AV_NOPTS_VALUE) {
+        /* Track timestamps include the DTS shift, but packets passed to
+         * mov_write_single_packet() do not yet include it. */
         ref -= trk->dts_shift;
     }
 
@@ -7128,7 +7129,7 @@ int ff_mov_write_packet(AVFormatContext *s, AVPacket *pkt)
         trk = &mov->tracks[pkt->stream_index];
     par = trk->par;
 
-    ret = check_pkt(s, trk, pkt);
+    ret = check_pkt(s, trk, pkt, 1);
     if (ret < 0)
         return ret;
 
@@ -7576,7 +7577,7 @@ static int mov_write_single_packet(AVFormatContext *s, AVPacket *pkt)
     int64_t frag_duration = 0;
     int size = pkt->size;
 
-    int ret = check_pkt(s, trk, pkt);
+    int ret = check_pkt(s, trk, pkt, 0);
     if (ret < 0)
         return ret;
 
@@ -7824,17 +7825,55 @@ static int mov_write_packet(AVFormatContext *s, AVPacket *pkt)
          *
          * 3) See mov_write_trailer for how the final end sample is
          * handled.
+         *
+         * 4) Split long empty intervals before check_pkt's signed duration
+         * limit when the next packet belongs to this subtitle track. Adding
+         * intermediate samples for another track can alter fragment timing.
          */
         for (i = 0; i < mov->nb_tracks; i++) {
             MOVTrack *trk = &mov->tracks[i];
-            int ret;
+            int64_t dts, end;
+            int ret, end_written = 0;
 
-            if (trk->par->codec_id == AV_CODEC_ID_MOV_TEXT &&
-                trk->track_duration < pkt->dts &&
-                (trk->entry == 0 || !trk->last_sample_is_subtitle_end)) {
-                ret = mov_write_subtitle_end_packet(s, i, trk->track_duration);
+            if (trk->par->codec_id != AV_CODEC_ID_MOV_TEXT ||
+                pkt->dts == AV_NOPTS_VALUE)
+                continue;
+
+            dts = av_rescale_q(pkt->dts, s->streams[pkt->stream_index]->time_base,
+                               (AVRational){1, trk->timescale});
+            if (trk->dts_shift != AV_NOPTS_VALUE)
+                dts = av_sat_add64(dts, trk->dts_shift);
+            end = trk->start_dts != AV_NOPTS_VALUE
+                ? av_sat_add64(trk->start_dts, trk->track_duration) : 0;
+            while (end < dts) {
+                int64_t previous_end = end;
+                int splitting = 0;
+
+                if (!end_written &&
+                    (trk->entry == 0 || !trk->last_sample_is_subtitle_end)) {
+                    if (trk->start_dts != AV_NOPTS_VALUE)
+                        end = av_sat_add64(trk->start_dts, trk->track_duration);
+                } else if (pkt->stream_index == trk->st->index &&
+                           av_sat_sub64(dts, end) >= INT_MAX) {
+                    end += INT_MAX - 1;
+                    splitting = 1;
+                } else {
+                    break;
+                }
+
+                ret = mov_write_subtitle_end_packet(s, i,
+                    trk->dts_shift != AV_NOPTS_VALUE ? av_sat_sub64(end, trk->dts_shift) : end);
                 if (ret < 0) return ret;
                 trk->last_sample_is_subtitle_end = 1;
+                end_written = 1;
+                if (trk->start_dts != AV_NOPTS_VALUE)
+                    end = av_sat_add64(trk->start_dts, trk->track_duration);
+                if (splitting && end <= previous_end) {
+                    av_log(s, AV_LOG_ERROR,
+                           "Subtitle gap splitting did not advance DTS in stream %d\n",
+                           trk->st->index);
+                    return AVERROR_INVALIDDATA;
+                }
             }
         }
 
