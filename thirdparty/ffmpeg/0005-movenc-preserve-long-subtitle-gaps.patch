From c610c7c7eb70d85dacaca4cd4008820c0b482a31 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Fri, 30 Oct 2026 20:54:06 +0100
Subject: [PATCH 2/3] avformat/movenc: fix final mov_text sample timestamp

The trailer passed track_duration directly as the final subtitle sample DTS, although track_duration is relative to start_dts. This placed the terminating empty sample too late for tracks with a nonzero or negative start timestamp.

Write the final sample at the absolute track end, undoing dts_shift when necessary, and propagate write errors. Extend the negative-start FATE test to check sample durations on the media timeline.

Signed-off-by: David C. Manuelda <StormByte@gmail.com>
---
 libavformat/movenc.c                               |  8 +++++++-
 tests/fate/mov.mak                                 |  2 +-
 .../ref/fate/mov-subtitle-long-gap-negative-start  | 14 ++++++++------
 3 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/libavformat/movenc.c b/libavformat/movenc.c
index da85c298d2c..9bdc36b73ee 100644
--- a/libavformat/movenc.c
+++ b/libavformat/movenc.c
@@ -9271,7 +9271,13 @@ static int mov_write_trailer(AVFormatContext *s)
         MOVTrack *trk = &mov->tracks[i];
         if (trk->par->codec_id == AV_CODEC_ID_MOV_TEXT &&
             !trk->last_sample_is_subtitle_end) {
-            mov_write_subtitle_end_packet(s, i, trk->track_duration);
+            int64_t end = trk->start_dts != AV_NOPTS_VALUE
+                ? av_sat_add64(trk->start_dts, trk->track_duration)
+                : trk->track_duration;
+            if (trk->dts_shift != AV_NOPTS_VALUE)
+                end = av_sat_sub64(end, trk->dts_shift);
+            if ((res = mov_write_subtitle_end_packet(s, i, end)) < 0)
+                return res;
             trk->last_sample_is_subtitle_end = 1;
         }
     }
