function(prepare_patched_checkout source work ready)
	cmake_path(IS_ABSOLUTE work absolute)
	cmake_path(NORMAL_PATH work OUTPUT_VARIABLE normalized_work)
	if(NOT absolute OR normalized_work STREQUAL "/" OR normalized_work MATCHES "^[A-Za-z]:/$")
		message(FATAL_ERROR "Patch fixture requires a non-root absolute work directory: ${work}")
	endif()
	set(work "${normalized_work}")
	find_package(Git QUIET)
	if(NOT GIT_FOUND OR NOT IS_DIRECTORY "${source}")
		message(STATUS "SKIPPED: Git checkout is unavailable: ${source}")
		set(${ready} FALSE PARENT_SCOPE)
		return()
	endif()
	execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse --show-toplevel
		RESULT_VARIABLE result OUTPUT_VARIABLE checkout_root
		OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
	file(REAL_PATH "${source}" expected_root)
	if("${work}/source" STREQUAL expected_root)
		message(FATAL_ERROR "Patch fixture cannot overwrite its source checkout")
	endif()
	if(result EQUAL 0)
		file(REAL_PATH "${checkout_root}" checkout_root)
	endif()
	if(NOT result EQUAL 0 OR NOT checkout_root STREQUAL expected_root)
		message(STATUS "SKIPPED: source is not a Git checkout: ${source}")
		set(${ready} FALSE PARENT_SCOPE)
		return()
	endif()

	file(REMOVE_RECURSE "${work}/source")
	file(MAKE_DIRECTORY "${work}/source")
	execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" archive
		--format=tar "--output=${work}/source.tar" HEAD
		RESULT_VARIABLE result ERROR_VARIABLE error)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "Cannot archive ${source}: ${error}")
	endif()
	execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${work}/source.tar"
		WORKING_DIRECTORY "${work}/source" RESULT_VARIABLE result ERROR_VARIABLE error)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "Cannot extract ${source}: ${error}")
	endif()
	foreach(patch IN LISTS ARGN)
		execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${work}"
			"${GIT_EXECUTABLE}" -C "${work}/source" apply "${patch}"
			RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "Cannot apply ${patch} to ${source}:\n${output}\n${error}")
		endif()
	endforeach()
	file(REMOVE "${work}/source.tar")
	set(${ready} TRUE PARENT_SCOPE)
endfunction()
