function(set_source_files_properties)
	set(arguments ${ARGN})
	set(sources)
	while(NOT "${arguments}" STREQUAL "")
		list(POP_FRONT arguments argument)
		if(argument STREQUAL "PROPERTIES")
			break()
		endif()
		list(APPEND sources "${argument}")
	endwhile()
	list(POP_FRONT arguments property)
	if(NOT property STREQUAL "COMPILE_OPTIONS")
		message(FATAL_ERROR "Unexpected source property: ${property}")
	endif()
	foreach(source IN LISTS sources)
		set_property(GLOBAL PROPERTY "${source}_OPTIONS" "${arguments}")
	endforeach()
endfunction()

function(get_source_file_property output source property)
	get_property(options GLOBAL PROPERTY "${source}_OPTIONS")
	set(${output} "${options}" PARENT_SCOPE)
endfunction()

function(check_options sources expected)
	foreach(source IN LISTS ${sources})
		get_source_file_property(actual "${source}" COMPILE_OPTIONS)
		if(NOT actual STREQUAL expected)
			message(FATAL_ERROR "${mode}: ${source}: expected '${expected}', got '${actual}'")
		endif()
	endforeach()
endfunction()

set(CMAKE_INSTALL_LIBDIR lib)
set(CMAKE_INSTALL_INCLUDEDIR include)
set(CMAKE_INSTALL_BINDIR bin)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

foreach(mode IN ITEMS GNU Clang clang-cl MSVC64 MSVC32)
	set(MSVC FALSE)
	set(CMAKE_CXX_COMPILER_ID "${mode}")
	set(CMAKE_SIZEOF_VOID_P 8)
	if(mode STREQUAL "clang-cl")
		set(MSVC TRUE)
		set(CMAKE_CXX_COMPILER_ID Clang)
	elseif(mode MATCHES "^MSVC")
		set(MSVC TRUE)
		set(CMAKE_CXX_COMPILER_ID MSVC)
		if(mode STREQUAL "MSVC32")
			set(CMAKE_SIZEOF_VOID_P 4)
		endif()
	endif()
	foreach(source IN LISTS ZIMG_SIMD_SOURCES)
		set_property(GLOBAL PROPERTY "${source}_OPTIONS" "")
	endforeach()
	include("${REPO}/thirdparty/zimg/cmake-wrapper/CMakeLists.txt")
	if(mode MATCHES "^MSVC")
		if(CMAKE_SIZEOF_VOID_P EQUAL 4)
			check_options(ZIMG_SSE_SOURCES "/arch:SSE")
			check_options(ZIMG_SSE2_SOURCES "/arch:SSE2")
		else()
			check_options(ZIMG_SSE_SOURCES "")
			check_options(ZIMG_SSE2_SOURCES "")
		endif()
		check_options(ZIMG_AVX_SOURCES "/arch:AVX")
		check_options(ZIMG_F16C_SOURCES "/arch:AVX")
		check_options(ZIMG_AVX2_SOURCES "/arch:AVX2")
		check_options(ZIMG_AVX512_SOURCES "/arch:AVX512")
		check_options(ZIMG_AVX512_VNNI_SOURCES "/arch:AVX512")
	else()
		set(prefix "")
		if(MSVC)
			set(prefix "/clang:")
		endif()
		check_options(ZIMG_SSE_SOURCES "${prefix}-msse")
		check_options(ZIMG_SSE2_SOURCES "${prefix}-msse2")
		check_options(ZIMG_AVX_SOURCES "${prefix}-mavx")
		check_options(ZIMG_F16C_SOURCES "${prefix}-mavx;${prefix}-mf16c")
		check_options(ZIMG_AVX2_SOURCES "${prefix}-mavx2;${prefix}-mf16c;${prefix}-mfma")
		set(avx512 "${prefix}-mavx512f;${prefix}-mavx512cd;${prefix}-mavx512vl;${prefix}-mavx512bw;${prefix}-mavx512dq")
		check_options(ZIMG_AVX512_SOURCES "${avx512}")
		check_options(ZIMG_AVX512_VNNI_SOURCES "${avx512};${prefix}-mavx512vnni")
	endif()
	check_options(ZIMG_CORE_SOURCES "")
	message(STATUS "zimg kernel options verified for ${mode}")
endforeach()

foreach(MSVC IN ITEMS FALSE TRUE)
	foreach(architecture IN ITEMS aarch64 arm64 ARM64 armv7)
		set(mode "${architecture}, MSVC=${MSVC}")
		set(CMAKE_SYSTEM_PROCESSOR "${architecture}")
		foreach(source IN LISTS ZIMG_SIMD_SOURCES)
			set_property(GLOBAL PROPERTY "${source}_OPTIONS" "")
		endforeach()
		set_property(GLOBAL PROPERTY ZIMG_TEST_DEFINITIONS "")
		include("${REPO}/thirdparty/zimg/cmake-wrapper/CMakeLists.txt")
		get_property(definitions GLOBAL PROPERTY ZIMG_TEST_DEFINITIONS)
		if(NOT ZIMG_IS_ARM OR ZIMG_IS_X86 OR NOT ZIMG_NEON_SOURCES
				OR NOT "ZIMG_ARM" IN_LIST definitions
				OR NOT "${ZIMG_SRC}/common/arm/cpuinfo_arm.cpp" IN_LIST ZIMG_CORE_SOURCES)
			message(FATAL_ERROR "${mode}: zimg ARM NEON sources or dispatch are missing")
		endif()
		if(architecture STREQUAL "armv7" AND NOT MSVC)
			check_options(ZIMG_NEON_SOURCES "-mfpu=neon")
		else()
			check_options(ZIMG_NEON_SOURCES "")
		endif()
		check_options(ZIMG_CORE_SOURCES "")
		message(STATUS "zimg NEON sources verified for ${mode}")
	endforeach()
endforeach()
