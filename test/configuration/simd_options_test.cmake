function(require_option variable value)
	if(NOT "${value}" IN_LIST ${variable})
		message(FATAL_ERROR "${CMAKE_SYSTEM_PROCESSOR}: ${variable} is missing ${value}")
	endif()
endfunction()

set(FFMPEG_BUNDLED_TYPE static)
set(CMAKE_INSTALL_LIBDIR lib)
set(BUILDMASTER_BINDIR "${CMAKE_CURRENT_BINARY_DIR}/simd-options")

foreach(msvc_mode IN ITEMS FALSE TRUE)
	set(MSVC "${msvc_mode}")
foreach(architecture IN ITEMS x86_64 aarch64)
	set(CMAKE_SYSTEM_PROCESSOR "${architecture}")
	foreach(component IN ITEMS codecs/audio/opus codecs/video/vpx codecs/video/webp
		codecs/video/aom codecs/video/svt-av1 codecs/video/x265 compressors/lzma)
		include("${REPO}/thirdparty/ffmpeg/plugins/${component}/CMakeLists.txt")
	endforeach()
	require_option(VPX_OPTIONS "-Druntime_cpu_detect=enabled")
	require_option(WEBP_OPTIONS "-DWEBP_ENABLE_SIMD=ON")
	require_option(AOM_OPTIONS "CONFIG_RUNTIME_CPU_DETECT=1")
	require_option(SVTAV1_OPTIONS "-DCOMPILE_C_ONLY=OFF")
	require_option(SVTAV1_OPTIONS "-DNATIVE=OFF")
	require_option(OPUS_OPTIONS "-DOPUS_DISABLE_INTRINSICS=OFF")
	require_option(OPUS_OPTIONS "-DOPUS_CHECK_ASM=OFF")
	require_option(OPUS_OPTIONS "-DOPUS_FUZZING=OFF")
	require_option(X265_COMMON "ENABLE_ASSEMBLY=ON")
	if(architecture STREQUAL "x86_64")
		require_option(AOM_OPTIONS "ENABLE_AVX512=ON")
		require_option(SVTAV1_OPTIONS "-DENABLE_AVX512=ON")
		require_option(OPUS_OPTIONS "-DOPUS_X86_MAY_HAVE_AVX2=ON")
		require_option(OPUS_OPTIONS "-DOPUS_X86_PRESUME_AVX2=OFF")
		require_option(LZMA_OPTIONS "-DXZ_CLMUL_CRC=ON")
	else()
		require_option(AOM_OPTIONS "ENABLE_NEON=ON")
		require_option(AOM_OPTIONS "ENABLE_SVE2=ON")
		require_option(SVTAV1_OPTIONS "-DENABLE_NEON=ON")
		require_option(X265_COMMON "ENABLE_NEON=ON")
		require_option(OPUS_OPTIONS "-DOPUS_MAY_HAVE_NEON=ON")
		require_option(LZMA_OPTIONS "-DXZ_ARM64_CRC32=ON")
		if("-DOPUS_X86_MAY_HAVE_AVX2=ON" IN_LIST OPUS_OPTIONS)
			message(FATAL_ERROR "x86 options leaked into ARM")
		endif()
	endif()
	message(STATUS "SIMD options verified for ${architecture}, MSVC=${MSVC}")
endforeach()
endforeach()

include("${REPO}/test/configuration/zimg_simd_options_test.cmake")
