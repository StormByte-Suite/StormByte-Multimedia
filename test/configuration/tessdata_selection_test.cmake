cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED REPO OR NOT DEFINED WORK)
	message(FATAL_ERROR "REPO and WORK are required")
endif()

set(TESSDATA_NAMESPACE tessdata)
set(TESSDATA_DIR "${WORK}/models")
set(GENERATED_TESSDATA_DIR "${WORK}/generated")
file(MAKE_DIRECTORY "${TESSDATA_DIR}")
foreach(language IN ITEMS eng jpn jpn_vert kor fra osd)
	file(WRITE "${TESSDATA_DIR}/${language}.traineddata" "fixture")
endforeach()
set(TESSDATA_LANGUAGES eng jpn kor jpn)
if(MISSING_MODEL)
	list(APPEND TESSDATA_LANGUAGES absent)
endif()
message(STATUS "[tessdata selection test] Using synthetic fixtures, not the bundled language selection")
include("${REPO}/thirdparty/tessdata/cmake-wrapper/tessdata.cmake")

list(LENGTH TESSDATA_FILES count)
if(NOT count EQUAL 4)
	message(FATAL_ERROR "Expected three base models and one vertical variant, got ${count}")
endif()
foreach(language IN ITEMS eng jpn jpn_vert kor)
	if(NOT "${TESSDATA_DIR}/${language}.traineddata" IN_LIST TESSDATA_FILES)
		message(FATAL_ERROR "Selected model missing: ${language}")
	endif()
endforeach()
foreach(language IN ITEMS fra osd kor_vert)
	if("${TESSDATA_DIR}/${language}.traineddata" IN_LIST TESSDATA_FILES)
		message(FATAL_ERROR "Unexpected model selected: ${language}")
	endif()
endforeach()

execute_process(COMMAND "${CMAKE_COMMAND}" "-DREPO=${REPO}" "-DWORK=${WORK}/missing"
	-DMISSING_MODEL=ON -P "${CMAKE_CURRENT_LIST_FILE}"
	RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${error}" MATCHES "Selected language model is missing")
	message(FATAL_ERROR "Missing selected model must fail explicitly: ${output}${error}")
endif()
message(STATUS "Tessdata selection, optional vertical variants and missing-model checks passed")
