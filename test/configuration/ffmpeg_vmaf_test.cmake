if(DEFINED TEST_FFMPEG)
	set(CMAKE_SOURCE_DIR "${REPO}")
	set(WITH_FFMPEG "${TEST_FFMPEG}")
	if(NOT TEST_VMAF STREQUAL "DEFAULT")
		set(WITH_VMAF "${TEST_VMAF}" CACHE STRING "VMAF mode" FORCE)
		set(WITH_VMAF "${TEST_VMAF}")
	endif()
	function(find_package)
	endfunction()
	function(add_library)
		set(selected_mode SYSTEM PARENT_SCOPE)
	endfunction()
	function(target_link_libraries)
	endfunction()
	function(target_include_directories target)
		if(NOT target STREQUAL "StormByte-Multimedia")
			message(FATAL_ERROR "Unexpected VMAF include target: ${target}")
		endif()
		set(checkout_headers TRUE PARENT_SCOPE)
	endfunction()
	function(buildmaster_component)
		set(selected_mode BUNDLED PARENT_SCOPE)
	endfunction()
	function(buildmaster_link)
	endfunction()
	set(checkout_headers FALSE)
	include("${REPO}/thirdparty/vmaf/CMakeLists.txt")
	get_property(cached_mode CACHE WITH_VMAF PROPERTY VALUE)
	if(NOT WITH_VMAF STREQUAL WITH_FFMPEG OR NOT cached_mode STREQUAL WITH_FFMPEG
		OR NOT selected_mode STREQUAL WITH_FFMPEG)
		message(FATAL_ERROR "VMAF variable, cache or selected dependency does not match FFmpeg")
	endif()
	if(WITH_VMAF STREQUAL "BUNDLED" AND NOT checkout_headers)
		message(FATAL_ERROR "Bundled VMAF is missing checkout headers")
	elseif(WITH_VMAF STREQUAL "SYSTEM" AND checkout_headers)
		message(FATAL_ERROR "System VMAF received bundled checkout headers")
	endif()
else()
	foreach(ffmpeg IN ITEMS BUNDLED SYSTEM)
		foreach(vmaf IN ITEMS BUNDLED SYSTEM DEFAULT)
			execute_process(COMMAND "${CMAKE_COMMAND}" "-DREPO=${REPO}"
				"-DTEST_FFMPEG=${ffmpeg}" "-DTEST_VMAF=${vmaf}"
				-P "${CMAKE_CURRENT_LIST_FILE}"
				RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
			if(NOT result EQUAL 0)
				message(FATAL_ERROR "${ffmpeg}/${vmaf} failed: ${output}${error}")
			endif()
			if(vmaf STREQUAL "DEFAULT")
				set(requested BUNDLED)
			else()
				set(requested "${vmaf}")
			endif()
			if(NOT requested STREQUAL ffmpeg)
				if(NOT output MATCHES "-- Overriding WITH_VMAF=${requested} with ${ffmpeg}")
					message(FATAL_ERROR "Override STATUS message missing: ${output}")
				endif()
			elseif(output MATCHES "Overriding WITH_VMAF")
				message(FATAL_ERROR "Unexpected override for matching modes: ${output}")
			endif()
			message(STATUS "FFmpeg=${ffmpeg} VMAF=${vmaf}: mode, cache, dependency selection and STATUS verified")
		endforeach()
	endforeach()
endif()