if(DEFINED TEST_CASE)
	set(CMAKE_SOURCE_DIR "${REPO}")
	set(checkout_headers FALSE)
	set(checkout_args "")
	function(find_package)
	endfunction()
	function(add_library)
	endfunction()
	function(target_link_libraries)
	endfunction()
	function(target_compile_definitions)
	endfunction()
	function(get_target_property variable)
		set(${variable} "" PARENT_SCOPE)
	endfunction()
	function(set_property)
	endfunction()
	function(buildmaster_component)
	endfunction()
	function(buildmaster_link)
	endfunction()
	function(buildmaster_group)
	endfunction()
	function(buildmaster_group_add)
	endfunction()
	function(target_include_directories target)
		if(NOT target STREQUAL "StormByte-Multimedia")
			return()
		endif()
		set(checkout_headers TRUE PARENT_SCOPE)
		set(checkout_args "${ARGN}" PARENT_SCOPE)
	endfunction()

	if(TEST_CASE STREQUAL "vmaf-bundled" OR TEST_CASE STREQUAL "vmaf-system")
		if(TEST_CASE STREQUAL "vmaf-bundled")
			set(WITH_FFMPEG "BUNDLED")
			set(WITH_VMAF "BUNDLED")
		else()
			set(WITH_FFMPEG "SYSTEM")
			set(WITH_VMAF "SYSTEM")
		endif()
		include("${REPO}/thirdparty/vmaf/CMakeLists.txt")
		set(_need "libvmaf/include")
	elseif(TEST_CASE STREQUAL "zimg-bundled" OR TEST_CASE STREQUAL "zimg-system")
		if(TEST_CASE STREQUAL "zimg-bundled")
			set(WITH_ZIMG "BUNDLED")
		else()
			set(WITH_ZIMG "SYSTEM")
		endif()
		include("${REPO}/thirdparty/zimg/CMakeLists.txt")
		set(_need "zimg/cmake-wrapper/src/src/zimg/api")
	elseif(TEST_CASE STREQUAL "ebur128-bundled" OR TEST_CASE STREQUAL "ebur128-system")
		if(TEST_CASE STREQUAL "ebur128-bundled")
			set(WITH_EBUR128 "BUNDLED")
		else()
			set(WITH_EBUR128 "SYSTEM")
		endif()
		include("${REPO}/thirdparty/ebur128/CMakeLists.txt")
		set(_need "ebur128/src/ebur128")
	elseif(TEST_CASE STREQUAL "tesseract-bundled")
		include("${REPO}/thirdparty/ocr/tesseract/CMakeLists.txt")
		set(_need "tesseract/src/include")
	elseif(TEST_CASE STREQUAL "leptonica-bundled")
		include("${REPO}/thirdparty/ocr/leptonica/CMakeLists.txt")
		set(_need "leptonica-api")
	elseif(TEST_CASE STREQUAL "tessdata-bundled" OR TEST_CASE STREQUAL "tessdata-system")
		if(TEST_CASE STREQUAL "tessdata-bundled")
			set(WITH_TESSDATA "BUNDLED")
		else()
			set(WITH_TESSDATA "SYSTEM")
		endif()
		include("${REPO}/thirdparty/tessdata/CMakeLists.txt")
		set(_need "tessdata/cmake-wrapper/include")
	else()
		message(FATAL_ERROR "Unknown bundled include case: ${TEST_CASE}")
	endif()

	if(TEST_CASE MATCHES "-system$")
		if(checkout_headers)
			message(FATAL_ERROR "${TEST_CASE} prepended checkout headers: ${checkout_args}")
		endif()
	else()
		if(NOT checkout_headers)
			message(FATAL_ERROR "${TEST_CASE} did not prepend checkout headers")
		endif()
		string(FIND "${checkout_args}" "BEFORE" _before)
		string(FIND "${checkout_args}" "${_need}" _hit)
		if(_before EQUAL -1 OR _hit EQUAL -1)
			message(FATAL_ERROR "${TEST_CASE} include args missing BEFORE ${_need}: ${checkout_args}")
		endif()
	endif()
else()
	file(READ "${REPO}/thirdparty/ffmpeg/CMakeLists.txt" _ffmpeg_lists)
	string(FIND "${_ffmpeg_lists}" "target_include_directories(StormByte-Multimedia BEFORE PRIVATE\n\t\t\"\${FFMPEG_SRC_DIR}\"" _ffmpeg_hit)
	if(_ffmpeg_hit EQUAL -1)
		string(FIND "${_ffmpeg_lists}" "target_include_directories(StormByte-Multimedia BEFORE PRIVATE\r\n\t\t\"\${FFMPEG_SRC_DIR}\"" _ffmpeg_hit)
	endif()
	if(_ffmpeg_hit EQUAL -1)
		message(FATAL_ERROR "Bundled FFmpeg does not prepend its checkout include directory")
	endif()
	string(FIND "${_ffmpeg_lists}" "if(WITH_FFMPEG STREQUAL \"SYSTEM\")" _ffmpeg_system_at)
	string(LENGTH "${_ffmpeg_lists}" _ffmpeg_len)
	math(EXPR _ffmpeg_rest "${_ffmpeg_len} - ${_ffmpeg_system_at}")
	string(SUBSTRING "${_ffmpeg_lists}" "${_ffmpeg_system_at}" "${_ffmpeg_rest}" _ffmpeg_tail)
	string(FIND "${_ffmpeg_tail}" "\nelse()" _ffmpeg_else_at)
	string(SUBSTRING "${_ffmpeg_tail}" 0 "${_ffmpeg_else_at}" _ffmpeg_system)
	if(_ffmpeg_system MATCHES "FFMPEG_SRC_DIR")
		message(FATAL_ERROR "System FFmpeg must not use the bundled checkout include directory")
	endif()

	foreach(component IN ITEMS base buffer logger system)
		file(READ "${REPO}/thirdparty/StormByte/${component}/CMakeLists.txt" _stormbyte_lists)
		if(NOT _stormbyte_lists MATCHES "stormbyte_component_url")
			message(FATAL_ERROR "StormByte ${component} is not a release archive")
		endif()
		if(NOT _stormbyte_lists MATCHES "BACKEND=binary")
			message(FATAL_ERROR "StormByte ${component} is not BACKEND=binary")
		endif()
		if(_stormbyte_lists MATCHES "target_include_directories")
			message(FATAL_ERROR "StormByte ${component} must not prepend a source checkout")
		endif()
	endforeach()

	foreach(case IN ITEMS
		vmaf-bundled vmaf-system
		zimg-bundled zimg-system
		ebur128-bundled ebur128-system
		tesseract-bundled
		leptonica-bundled
		tessdata-bundled tessdata-system
	)
		execute_process(COMMAND "${CMAKE_COMMAND}" "-DREPO=${REPO}" "-DTEST_CASE=${case}"
			-P "${CMAKE_CURRENT_LIST_FILE}"
			RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
		if(NOT result EQUAL 0)
			message(FATAL_ERROR "${case} failed: ${output}${error}")
		endif()
		message(STATUS "${case}: bundled checkout include order verified")
	endforeach()
endif()
