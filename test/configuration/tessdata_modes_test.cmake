cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED REPO OR NOT DEFINED WORK)
	message(FATAL_ERROR "REPO and WORK are required")
endif()

file(MAKE_DIRECTORY "${WORK}/partial")
file(WRITE "${WORK}/partial/eng.traineddata" "fixture")
set(TESSDATA_DIR "${WORK}/partial")
list(APPEND CMAKE_MODULE_PATH "${REPO}/cmake")
find_package(Tessdata REQUIRED)
if(NOT TESSDATA_DIR STREQUAL "${WORK}/partial" OR NOT TESSDATA_LANGUAGE_COUNT EQUAL 1)
	message(FATAL_ERROR "SYSTEM must accept a directory with a single installed model")
endif()

set(source "${REPO}/thirdparty/tessdata")
file(WRITE "${WORK}/CMakeLists.txt"
"cmake_minimum_required(VERSION 3.20)
project(TessdataModes LANGUAGES CXX)
function(buildmaster_component)
endfunction()
function(buildmaster_link)
endfunction()
function(buildmaster_group_add)
endfunction()
add_library(StormByte-Multimedia STATIC dummy.cxx \"${REPO}/lib/private/StormByte/multimedia/ocr/tessdata.cxx\")
set_target_properties(StormByte-Multimedia PROPERTIES LINKER_LANGUAGE CXX)
list(APPEND CMAKE_MODULE_PATH \"${REPO}/cmake\")
include(\"${source}/CMakeLists.txt\")
get_target_property(defines StormByte-Multimedia COMPILE_DEFINITIONS)
get_target_property(sources StormByte-Multimedia SOURCES)
if(WITH_TESSDATA STREQUAL SYSTEM)
  if(NOT STORMBYTE_MULTIMEDIA_TESSDATA_SYSTEM IN_LIST defines)
    message(FATAL_ERROR \"Missing private SYSTEM define\")
  endif()
  foreach(item IN LISTS sources)
    if(item MATCHES \"/ocr/tessdata\\.cxx$\")
      message(FATAL_ERROR \"SYSTEM must not compile embedded catalog\")
    endif()
  endforeach()
endif()
")
file(WRITE "${WORK}/dummy.cxx" "")
foreach(mode IN ITEMS BUNDLED SYSTEM)
	execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}" -B "${WORK}/${mode}"
		"-DWITH_TESSDATA=${mode}" "-DTESSDATA_DIR=${WORK}/partial"
		-DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DCMAKE_C_COMPILER_LAUNCHER=ccache
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "${mode}: ${output}${error}")
	endif()
endforeach()
