cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED REPO OR NOT DEFINED WORK OR WORK STREQUAL ""
		OR NOT DEFINED C_COMPILER OR NOT DEFINED CXX_COMPILER OR NOT DEFINED PROCESSOR)
	message(FATAL_ERROR "REPO, WORK, C_COMPILER, CXX_COMPILER and PROCESSOR are required")
endif()

set(FFMPEG "${REPO}/thirdparty/ffmpeg")
file(READ "${FFMPEG}/CMakeLists.txt" ffmpeg_cmake)
string(REGEX MATCHALL "\\\${CMAKE_CURRENT_LIST_DIR}/[0-9][0-9][0-9][0-9]-[^\"]+\\.patch"
	registered "${ffmpeg_cmake}")
set(patches)
foreach(entry IN LISTS registered)
	string(REPLACE "\${CMAKE_CURRENT_LIST_DIR}" "${FFMPEG}" entry "${entry}")
	list(APPEND patches "${entry}")
endforeach()
file(GLOB available LIST_DIRECTORIES FALSE "${FFMPEG}/[0-9][0-9][0-9][0-9]-*.patch")
list(SORT available)
if(NOT patches STREQUAL available)
	message(FATAL_ERROR "FFmpeg patch registration mismatch:\nregistered=${patches}\navailable=${available}")
endif()
if(NOT "${FFMPEG}/0014-meson-fix-intrinsics-probes.patch" IN_LIST patches)
	message(FATAL_ERROR "FFmpeg intrinsics probe patch is not registered")
endif()

find_program(MESON_EXECUTABLE meson)
if(NOT MESON_EXECUTABLE)
	message(STATUS "SKIPPED: Meson is unavailable")
	return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/patched_checkout.cmake")
prepare_patched_checkout("${FFMPEG}/src" "${WORK}" ready ${patches})
if(NOT ready)
	return()
endif()

# Mirrors how FFmpeg's Meson 'compiles' checks join header prefix and code.
function(read_probe name output)
	file(STRINGS "${WORK}/source/meson.build" lines REGEX "^  \\['${name}', ")
	list(LENGTH lines count)
	if(NOT count EQUAL 1)
		message(FATAL_ERROR "Cannot locate the ${name} Meson probe")
	endif()
	if(NOT lines MATCHES "^  \\['${name}', \\['([^']+)'\\], '(.+)'\\],$")
		message(FATAL_ERROR "Unexpected ${name} Meson probe: ${lines}")
	endif()
	string(REPLACE "\\;" ";" code "${CMAKE_MATCH_2}")
	set(${output} "#include <${CMAKE_MATCH_1}>\n\n\n${code}\n" PARENT_SCOPE)
endfunction()

function(check_probe name target expected)
	read_probe(${name} code)
	file(WRITE "${WORK}/${name}-${target}.c" "${code}")
	execute_process(COMMAND "${C_COMPILER}" "--target=${target}" -std=c17 -ffreestanding
		-Werror=implicit-function-declaration -c "${WORK}/${name}-${target}.c"
		-o "${WORK}/${name}-${target}.o"
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(expected AND NOT result EQUAL 0)
		message(FATAL_ERROR "${name} probe rejects ${target}:\n${code}\n${output}\n${error}")
	elseif(NOT expected AND result EQUAL 0)
		message(FATAL_ERROR "${name} probe unexpectedly accepts ${target}")
	endif()
	message(STATUS "${name} probe for ${target} verified")
endfunction()

execute_process(COMMAND "${C_COMPILER}" --version OUTPUT_VARIABLE compiler_version ERROR_QUIET)
if(compiler_version MATCHES "clang")
	check_probe(intrinsics_neon aarch64-linux-gnu TRUE)
	check_probe(intrinsics_sse2 x86_64-linux-gnu TRUE)
	check_probe(intrinsics_neon x86_64-linux-gnu FALSE)
	check_probe(intrinsics_sse2 aarch64-linux-gnu FALSE)
endif()

set(meson_options -Ddefault_library=static -Dauto_features=disabled -Dasm=enabled
	-Dinline_asm=enabled -Dx86asm=disabled -Dprograms=disabled -Dtests=disabled
	-Davdevice=disabled -Davformat=disabled -Davfilter=disabled -Dswresample=disabled
	-Dswscale=disabled -Davcodec=enabled -Dh263_decoder=enabled)

function(check_configuration name expected_neon expected_sse2)
	execute_process(COMMAND "${CMAKE_COMMAND}" -E env "CC=${C_COMPILER}" "CXX=${CXX_COMPILER}"
		"${MESON_EXECUTABLE}" setup "${WORK}/${name}" "${WORK}/source" ${meson_options} ${ARGN}
		RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "${name}: FFmpeg Meson configuration failed:\n${output}\n${error}")
	endif()
	file(STRINGS "${WORK}/${name}/config.h" defines REGEX "^#define HAVE_INTRINSICS_")
	foreach(probe IN ITEMS NEON SSE2)
		string(TOLOWER "${probe}" lower)
		if(expected_${lower} STREQUAL "ANY")
			continue()
		endif()
		set(value 0)
		if(expected_${lower})
			set(value 1)
		endif()
		if(NOT "#define HAVE_INTRINSICS_${probe} ${value}" IN_LIST defines)
			message(FATAL_ERROR "${name}: expected HAVE_INTRINSICS_${probe} ${value}: ${defines}")
		endif()
	endforeach()
	set(neon_selected FALSE)
	if("#define HAVE_INTRINSICS_NEON 1" IN_LIST defines)
		set(neon_selected TRUE)
	endif()
	file(READ "${WORK}/${name}/build.ninja" ninja)
	string(FIND "${ninja}" "libavcodec/neon/mpegvideo.c" neon_source)
	if(neon_selected AND neon_source LESS 0)
		message(FATAL_ERROR "${name}: HAVE_INTRINSICS_NEON lacks libavcodec/neon/mpegvideo.c")
	elseif(NOT neon_selected AND NOT neon_source LESS 0)
		message(FATAL_ERROR "${name}: libavcodec/neon/mpegvideo.c selected without NEON intrinsics")
	endif()
	message(STATUS "${name}: FFmpeg intrinsics configuration verified")
endfunction()

file(REMOVE_RECURSE "${WORK}/native" "${WORK}/arm64")
if(PROCESSOR MATCHES "^(x86_64|AMD64|amd64|x64|i[3-6]86|x86)$")
	check_configuration(native FALSE TRUE)
elseif(PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
	check_configuration(native TRUE FALSE)
else()
	check_configuration(native ANY ANY)
endif()

if(NOT "$ENV{STORMBYTE_FFMPEG_ARM64_CROSS_FILE}" STREQUAL "")
	check_configuration(arm64 TRUE FALSE
		"--cross-file=$ENV{STORMBYTE_FFMPEG_ARM64_CROSS_FILE}")
endif()

file(GLOB probe_files "${WORK}/intrinsics_*")
file(REMOVE_RECURSE "${WORK}/source" "${WORK}/native" "${WORK}/arm64" ${probe_files})
