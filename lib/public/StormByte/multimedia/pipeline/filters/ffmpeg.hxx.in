#pragma once

#include <StormByte/logger/log.hxx>
#include <StormByte/multimedia/ffmpeg/AVFrame.hxx>
#include <StormByte/multimedia/ffmpeg/AVPacket.hxx>
#include <StormByte/multimedia/pipeline/filters/report.hxx>
#include <StormByte/multimedia/pipeline/frame.hxx>
#include <StormByte/multimedia/pipeline/packet.hxx>
#include <StormByte/multimedia/pipeline/plan.hxx>
#include <StormByte/multimedia/pipeline/telemetry.hxx>
#include <StormByte/multimedia/pipeline/typedefs.hxx>
#include <StormByte/multimedia/type.hxx>
#include <StormByte/multimedia/visibility.h>

#include <atomic>
#include <condition_variable>
#include <cstddef>
#include <cstdint>
#include <deque>
#include <memory>
#include <mutex>
#include <optional>
#include <string>
#include <string_view>

namespace StormByte::Multimedia::Backend::Pipeline {
	class Host;
	class Pipe;
	class Pumper;
	class Worker;
}

namespace StormByte::Multimedia::Backend::Pipeline::Detail::Worker {
	class Filter;
}

namespace StormByte::Multimedia::Pipeline {
	class Filters;
	class Route;
}

/**
 * @namespace StormByte::Multimedia::Pipeline::Filter
 * @brief Facades and reports for pipeline filters.
 */
namespace StormByte::Multimedia::Pipeline::Filter {
	class ProcessTwoPasses;

	/**
	 * @class FFmpeg
	 * @brief Abstract base for every StormByte Multimedia filter.
	 *
	 * FFmpeg is not a @ref StormByte::Multimedia::Pipeline::Step.
	 * A Step is a named node of the public graph (Demuxer, Decoder,
	 * Encoder, Muxer, Remuxer). A filter sits between two of those
	 * nodes. Inheriting FFmpeg does not make the leaf a Step.
	 *
	 * @par How to write a filter
	 * Inherit @ref Process, @ref ProcessTwoPasses, @ref Packet or
	 * @ref Analytics. Never inherit FFmpeg. Never inherit Step.
	 *
	 * Construct the leaf with a shared logger and a short name
	 * (`scale`) via the Process / ProcessTwoPasses / Packet /
	 * Analytics constructor. @ref Name is `Media()/name`. The job
	 * manages attachment and worker lifecycle. A destructor only
	 * releases filter resources.
	 *
	 * Implement @ref Media, @ref Clean, @ref Setup and the
	 * @ref Process overload that matches the kind. A
	 * @ref ProcessTwoPasses leaf implements @ref Process as the
	 * rewrite pass and @ref ProcessTwoPasses::Measure as the first
	 * look at the origin. @ref Process is not a dispatcher.
	 * Clean must be callable more than once; Setup runs after
	 * Clean. Mutate through
	 * @ref StormByte::Multimedia::FFmpeg::AVFrame /
	 * @ref StormByte::Multimedia::FFmpeg::AVPacket and @ref Save.
	 * @ref Fail is a hard error. @ref Log is not Fail. An
	 * @ref Analytics filter implements
	 * @ref Process(const Pipeline::Frame&) only and reports
	 * numbers via @ref Report.
	 *
	 * Optional: @ref Hold / @ref Release / @ref LastChance /
	 * @ref Eof.
	 *
	 * Attach the leaf from the tube
	 * (@c job.Video(in).Filter<T>(…)). Do not wire anything
	 * from inside the filter.
	 *
	 * @par Kinds
	 * @ref Receives and @ref Produces are fixed at construction.
	 * The short constructor of @ref Process, @ref ProcessTwoPasses
	 * and @ref Packet fills the usual single-kind mask. The short
	 * constructor of @ref Analytics receives Frame and produces
	 * Frame. Both looks arrive as Frame.
	 *
	 * @par Headers and FFmpeg
	 * The filter contract is the public RAII types
	 * @ref StormByte::Multimedia::FFmpeg::AVFrame and
	 * @ref StormByte::Multimedia::FFmpeg::AVPacket
	 * (`StormByte/multimedia/ffmpeg/AVFrame.hxx`,
	 * `StormByte/multimedia/ffmpeg/AVPacket.hxx`).
	 * Those wrappers should expose everything a filter needs.
	 * The getters on this class borrow the current unit.
	 * Copy and @c Clone of a getter share plane / packet
	 * buffers (`av_frame_ref` / `av_packet_ref`); they are not
	 * a deep copy. @ref Save takes a distinct wrapper by
	 * rvalue and replaces the current unit. Do not @ref Save
	 * the getter's handle. Do not free a resource that still
	 * belongs to a wrapper or that @ref Save has already taken.
	 *
	 * StormByte-Multimedia does not install or export libav /
	 * libsw headers. Include those headers of the FFmpeg build
	 * this library was compiled against only if a needed
	 * operation is missing on the wrapper:
	 * FFmpeg @STORMBYTE_FFMPEG_VERSION@, libavcodec major
	 * @STORMBYTE_LIBAVCODEC_MAJOR@. Matching docs:
	 * https://ffmpeg.org/doxygen/@STORMBYTE_FFMPEG_VERSION@/index.html
	 *
	 * That C API is an escape only — not the API this header
	 * advertises. Do not link libavcodec, libavformat, libavutil,
	 * libswscale or libswresample in the filter.
	 * StormByte-Multimedia already links them. A second copy of
	 * those ABIs fails at load or at the first `av_*` call.
	 * Open an issue for the missing RAII surface so the escape
	 * can go away.
	 *
	 * StormByte value types that a filter already sees through
	 * @ref Pipeline::Frame keep the C names where they pair:
	 * @ref StormByte::Multimedia::Property::AVRational is `{num, den}`
	 * (`AVRational{24000, 1001}`, `fps.num`, `fps.den`). Convert to
	 * `::AVRational` with `{r.num, r.den}`. On @ref Property::Video that
	 * is @c FrameRate and @c SampleAspectRatio. Speaker layout is
	 * @ref StormByte::Multimedia::Property::ChannelLayout, a curated
	 * enum — not `AVChannelLayout`.
	 *
	 * @par Logging
	 * The owner of the tube passes a
	 * @c std::shared_ptr<StormByte::Logger::Log> as the first
	 * constructor argument. Prefer
	 * @c StormByte::Logger::ThreadedLog: every filter runs on its
	 * own worker. A plain @c Log is only safe if a single thread
	 * writes. An empty pointer is a silent no-op, not a Fail.
	 *
	 * Logging uses @c StormByte/Multimedia/&lt;Leaf&gt;
	 * (the first letter of the leaf name is capitalized). @ref Log
	 * writes on that facade. Format is `[%L] %T %c`. There is
	 * no STMM component and no Logger group. Levels are
	 * @c StormByte::Logger::Level (`LowLevel`, `Debug`, `Warning`,
	 * `Notice`, `Info`, `Error`, `Fatal`). The print floor is
	 * set on the application logger. Module throttle is
	 * applied to the filter module. Format the text before the call
	 * (`std::format`). Logging is not @ref Fail and is not a
	 * measurement; @ref Analytics still reports numbers via
	 * @ref Report.
	 *
	 * Full logger API:
	 * <a href="https://dev.stormbyte.org/StormByte-Logger/">StormByte-Logger</a>.
	 *
	 * @par Filter surface
	 * Public: @ref Media, @ref Name, @ref Clean, @ref Setup,
	 * @ref Receives, @ref Produces, @ref Failed, @ref Error and
	 * the @ref Process overload that matches those masks.
	 * A @ref ProcessTwoPasses leaf also implements
	 * @ref ProcessTwoPasses::Measure and may override
	 * @ref ProcessTwoPasses::Measured. @ref Process on that leaf
	 * is the rewrite pass, same as @ref Process.
	 * Protected: @ref Log, the AVFrame / AVPacket getters,
	 * @ref Save, @ref Hold, @ref Release, @ref LastChance,
	 * @ref Fail, @ref Held, @ref HeldFor, @ref Eof.
	 *
	 * @par Hold
	 * @ref Hold parks incoming units so @ref Process can look at a
	 * window (letterbox, loudness, a decoder delay) before anything
	 * reaches the next node. @p n of 0 means 255. A second Hold
	 * while @ref Held is @ref Fail. Exactly @p n units may sit on
	 * the queue. The next unit that would exceed that ceiling runs
	 * @ref LastChance instead of parking. If that call returns
	 * without @ref Release, @ref Fail runs and the job stops.
	 * Hold plus EoF is the same path: @ref LastChance on the last
	 * parked unit, then @ref Fail if still Held.
	 *
	 * @ref Release ends the Hold and runs @ref Process again on
	 * every parked unit (now with the state the probe computed),
	 * then they leave in that same call. A Release from
	 * LastChance at end-of-input still flushes.
	 *
	 * @par Mutation
	 * Effect of a mutation is @ref Save. @ref Analytics deletes
	 * @ref Save : an analytics leaf must not rewrite units.
	 * Paint a new @ref StormByte::Multimedia::FFmpeg::AVFrame
	 * or @ref StormByte::Multimedia::FFmpeg::AVPacket (graph
	 * output, @c AllocVideo / @c AllocAudio, or @c Copy plus
	 * @c CopyProps). Then @ref Save that wrapper by rvalue.
	 * Serial, Part and timing stay on the StormByte Frame /
	 * Packet. The replacement becomes the unit seen downstream.
	 *
	 * The getters borrow the current unit. @ref Save of that
	 * same raw handle is @ref Fail. Copy / @c Clone of a getter
	 * shares buffers; writing those planes writes the look.
	 *
	 * On @ref ProcessTwoPasses during the measure pass @ref Save
	 * is a no-op and the unit is not forwarded.
	 *
	 * Metadata that no longer matches the replacement (HDR10+
	 * windows, audio downmix) may be dropped or remapped. That is
	 * not @ref Fail. @ref Log writes @c Level::Warning with the
	 * reason. HDR10 static metadata is not rebuilt
	 * here; it rides on the incoming frame if @c CopyProps /
	 * @c WriteHdr10 copied it.
	 *
	 * @ingroup multimedia_pipeline
	 */
	class STORMBYTE_MULTIMEDIA_PUBLIC FFmpeg {
		friend class StormByte::Multimedia::Pipeline::Filters;
		friend class StormByte::Multimedia::Pipeline::Route;
		friend class StormByte::Multimedia::Backend::Pipeline::Detail::Worker::Filter;
		friend class ProcessTwoPasses;

		public:
			/**
			 * @name Lifecycle
			 * @{
			 */

			/**
			 * @brief Copy is not allowed. A filter owns hoppers and a worker.
			 */
			FFmpeg(const FFmpeg& other) = delete;

			/**
			 * @brief Move is not allowed. The leaf stays where the tube mounted it.
			 */
			FFmpeg(FFmpeg&& other) noexcept = delete;

			/**
			 * @brief Destructor. Joins if the worker ran. The leaf
			 *        only releases filter resources.
			 */
			virtual ~FFmpeg() noexcept;

			/**
			 * @brief Copy assignment is not allowed.
			 */
			FFmpeg& operator=(const FFmpeg& other) = delete;

			/**
			 * @brief Move assignment is not allowed.
			 */
			FFmpeg& operator=(FFmpeg&& other) noexcept = delete;

			/**
			 * @}
			 */

			/**
			 * @name Identity
			 * @{
			 */

			/**
			 * @brief Media this filter handles.
			 * @return Video, Audio or Subtitle.
			 */
			virtual enum StormByte::Multimedia::Type Media() const noexcept = 0;

			/**
			 * @brief `Media()/name` computed on each call.
			 * @return Identity string.
			 */
			std::string Name() const noexcept;

			/**
			 * @brief Shared counters retained independently of this filter.
			 * @return Const stage metrics with this filter's origin label.
			 */
			std::shared_ptr<const Pipeline::StageTelemetry> Telemetry() const noexcept;

			/**
			 * @brief Leaf token used in reports (`vmaf`).
			 * @return Constructor name, not `Media()/name`.
			 */
			inline const std::string& Leaf() const noexcept {
				return m_name;
			}

			/**
			 * @brief Kinds this filter consumes.
			 * @return Mask set at construction.
			 */
			inline const Pipeline::Kinds& Receives() const noexcept {
				return m_receives;
			}

			/**
			 * @brief Kinds this filter emits.
			 * @return Mask set at construction.
			 */
			inline const Pipeline::Kinds& Produces() const noexcept {
				return m_produces;
			}

			/**
			 * @}
			 */

			/**
			 * @name Run
			 * @{
			 */

			/**
			 * @brief Drops per-run state. First-run no-op is allowed.
			 *
			 * Called before @ref Setup and again if
			 * the tube reuses the leaf. Must be idempotent.
			 */
			virtual void Clean() noexcept = 0;

			/**
			 * @brief Acquires per-run state. Must be callable again after @ref Clean.
			 *
			 * Prepare the filter for a new run. Worker lifecycle is
			 * managed by the job.
			 */
			virtual void Setup() noexcept = 0;

			/**
			 * @brief Frame body. Default no-op.
			 * @param frame Unit in the tube. Never null.
			 *
			 * On @ref Analytics this is both looks. Read
			 * @ref StormByte::Multimedia::Pipeline::Item::Producer :
			 * Decoder is the reference look. Encoder or Remuxer is
			 * the distorted look, already decoded. Pair them in
			 * presentation order per track.
			 *
			 * On @ref ProcessTwoPasses this is the rewrite pass
			 * after measure. The tube calls
			 * @ref ProcessTwoPasses::Measure during the first pass.
			 */
			virtual void Process(const Pipeline::Frame& frame) noexcept;

			/**
			 * @brief Packet body. Default no-op.
			 * @param packet Unit in the tube. Never null.
			 *
			 * @ref Packet leaves implement this. @ref Analytics
			 * does not receive packets.
			 */
			virtual void Process(const Pipeline::Packet& packet) noexcept;

			/**
			 * @brief Measurement, if any.
			 * @return None and an empty map by default.
			 *
			 * @ref Analytics overrides this. A process or packet
			 * leaf may leave the default.
			 */
			virtual class Report Report() const noexcept;

			/**
			 * @brief Current lifecycle value.
			 * @return @ref Pipeline::State of this filter only.
			 */
			Pipeline::State Status() const noexcept;

			/**
			 * @brief Whether this filter has failed.
			 * @return true iff Status is Failed.
			 */
			bool Failed() const noexcept;

			/**
			 * @brief Failure text.
			 * @return Message, or empty.
			 */
			const std::optional<std::string>& Error() const noexcept;

			/**
			 * @brief Ceiling of this filter's input hopper.
			 * @return Max queued items. 0 means unbounded.
			 *
			 * The limit follows the job's configured buffering policy.
			 * The filter must be attached to a job before use.
			 */
			virtual std::size_t InputCeiling() const noexcept;

			/**
			 * @}
			 */

		protected:
			/**
			 * @name Construction
			 * @{
			 */

			/**
			 * @brief Named filter. There is no empty constructor.
			 * @param log Shared logger. Prefer ThreadedLog. Empty means no log.
			 * @param name Short leaf name (`scale`). Capitalized in the
			 *        logging scope @c StormByte/Multimedia/&lt;Leaf&gt;.
			 * @param receives Kinds this filter consumes.
			 * @param produces Kinds this filter emits.
			 *
			 * Called from @ref Process, @ref ProcessTwoPasses,
			 * @ref Packet and @ref Analytics.
			 * Do not construct FFmpeg from a filter leaf.
			 */
			FFmpeg(std::shared_ptr<StormByte::Logger::Log> log,
				std::string name, Pipeline::Kinds receives, Pipeline::Kinds produces) noexcept;

			/**
			 * @}
			 */

			/**
			 * @brief Writes one log line on the scoped module logger.
			 * @param level StormByte::Logger::Level of this line.
			 * @param message Already-formatted text.
			 *
			 * %c is @c StormByte/Multimedia/&lt;Leaf&gt;. No-op if the logger
			 * is empty. Safe from the destructor (does not call
			 * @ref Media).
			 */
			void Log(StormByte::Logger::Level level, std::string_view message) noexcept;

			/**
			 * @brief Marks a hard error and wakes the filter. The job stops.
			 * @param reason Bare message.
			 */
			void Fail(std::string reason) noexcept;

			/**
			 * @brief Starts a Hold of at most @p n units.
			 *
			 * @p n of 0 means 255. Parks the current unit. Later
			 * units while Held are parked. @ref Release may
			 * run before the ceiling. @ref HeldFor equal to @p n is
			 * still valid; the next unit is @ref LastChance, not a
			 * park. A second Hold while @ref Held is @ref Fail.
			 *
			 * @param n Maximum units for this Hold.
			 */
			void Hold(std::uint8_t n) noexcept;

			/**
			 * @brief Ends the Hold and replays parked units through
			 *        @ref Process, then Emits them.
			 *
			 * Runs in the same call (not deferred). No-op if
			 * not @ref Held. Set probe state before calling this.
			 */
			void Release() noexcept;

			/**
			 * @brief Whether this filter is inside a Hold.
			 * @return true after @ref Hold and before @ref Release.
			 */
			bool Held() const noexcept;

			/**
			 * @brief Units currently parked in the Hold queue.
			 * @return Count, or 0 if not Held.
			 */
			std::uint8_t HeldFor() const noexcept;

			/**
			 * @brief Filter-visible end-of-input hook. Default no-op.
			 *
			 * Called at end-of-input after a Hold has been
			 * released or failed. Complete any outstanding filter
			 * work here.
			 */
			virtual void Eof() noexcept;

			/**
			 * @brief Last look before the Hold must end.
			 *
			 * Called when one more unit would overflow the queue, and
			 * when input ends while still Held. Default no-op.
			 * Override to @ref Release with a sane default, or leave
			 * Held and let the job @ref Fail. Not called if the leaf
			 * never Holds.
			 *
			 * @param frame Current frame, or last parked frame on EoF.
			 */
			virtual void LastChance(const Pipeline::Frame& frame) noexcept;

			/**
			 * @brief Last look before the Hold must end.
			 * @param packet Current packet, or last parked packet on EoF.
			 */
			virtual void LastChance(const Pipeline::Packet& packet) noexcept;

			/**
			 * @brief Borrowed RAII handle of the current frame.
			 * @return @ref StormByte::Multimedia::FFmpeg::AVFrame of the
			 *         unit in @ref Process, or an empty handle if there
			 *         is no current frame.
			 *
			 * Valid only for this Work call. Do not store it. Do not
			 * free the resource: the wrapper owns it. Prefer methods
			 * on the RAII type. If one is missing, the C API of the
			 * linked FFmpeg build is an escape only — open an issue.
			 *
			 * This is not the argument of @ref Save. Copy and @c Clone
			 * share plane buffers with the current unit.
			 */
			const StormByte::Multimedia::FFmpeg::AVFrame& AVFrame() const noexcept;

			/**
			 * @brief Borrowed RAII handle of the current packet.
			 * @return @ref StormByte::Multimedia::FFmpeg::AVPacket of the
			 *         unit in @ref Process, or an empty handle if there
			 *         is no current packet.
			 *
			 * Valid only for this Work call. Do not store it. Do not
			 * free the resource: the wrapper owns it. Prefer methods
			 * on the RAII type. If one is missing, the C API of the
			 * linked FFmpeg build is an escape only — open an issue.
			 *
			 * This is not the argument of @ref Save. Copy and @c Clone
			 * share compressed buffers with the current unit.
			 */
			const StormByte::Multimedia::FFmpeg::AVPacket& AVPacket() const noexcept;

			/**
			 * @brief Replaces the media of the current frame.
			 * @param incoming Distinct RAII frame taken by rvalue.
			 *
			 * Serial, Part and timing stay on the StormByte Frame.
			 * Clears the packed Payload FIFO. The filter does not
			 * pass a geometry hint. @p incoming must not be the
			 * getter's handle; that is @ref Fail. An empty wrapper
			 * is a Warning and a return.
			 *
			 * Coupled extras that would lie after the new card may
			 * be dropped or remapped by Video::Put; that is not
			 * @ref Fail. @ref Log writes @c Level::Warning with
			 * the holder's reason.
			 *
			 * On @ref ProcessTwoPasses during the measure pass this
			 * is a no-op and the unit is not forwarded.
			 */
			void Save(StormByte::Multimedia::FFmpeg::AVFrame&& incoming) noexcept;

			/**
			 * @brief Replaces the media of the current packet.
			 * @param incoming Distinct RAII packet taken by rvalue.
			 *
			 * Clears the packed Payload FIFO. @p incoming must not
			 * be the getter's handle; that is @ref Fail. An empty
			 * wrapper is a Warning and a return.
			 *
			 * On @ref ProcessTwoPasses during the measure pass this
			 * is a no-op and the unit is not forwarded.
			 */
			void Save(StormByte::Multimedia::FFmpeg::AVPacket&& incoming) noexcept;

			/** @cond */
		private:
			class Surface;

			/**
			 * @brief Clean + filter Setup once before the first unit.
			 */
			void Open() noexcept;

			/**
			 * @brief Process one unit. Save or passthrough. Park if Held.
			 * @param item Never empty.
			 */
			void Work(Pipeline::Item::PointerType item) noexcept;

			/**
			 * @brief If Held, @ref LastChance on the last parked unit.
			 *        Still Held afterwards is Fail. Then @ref Eof.
			 */
			void Finish() noexcept;

			/**
			 * @brief Parks @ref m_current if it is not already the tail.
			 */
			void Park() noexcept;

			/**
			 * @brief Dispatches @ref LastChance to the kind of @ref m_current.
			 */
			void CallLastChance() noexcept;

			/**
			 * @brief Write @p item to the Pipe (@c item >> pipe).
			 */
			void Emit(Pipeline::Item::PointerType item) noexcept;

			/**
			 * @brief Sleeps on Wake until hopper Ready, Failed, Stopping,
			 *        or a two-pass measure source closed with an empty hopper.
			 */
			void Wait() noexcept;

			/**
			 * @brief Starts the pumper: Setup, Ready, Pump.
			 */
			void Launch() noexcept;

			/**
			 * @brief Stop and join the pumper.
			 */
			void Halt() noexcept;

			/**
			 * @brief Asks the worker to leave and closes hoppers.
			 */
			void Stop() noexcept;

			/**
			 * @brief Worker must return.
			 */
			bool Stopping() const noexcept;

			/**
			 * @brief Owner surface for the Pumper and Worker.
			 */
			Backend::Pipeline::Host& Face() noexcept;

			/**
			 * @brief Consumer condition variable.
			 */
			std::condition_variable& Wake() noexcept;

			/**
			 * @brief Eof on the Pipe.
			 */
			void CloseHoppers() noexcept;

			/**
			 * @brief Records one timed @ref Process call.
			 * @param microseconds Duration of that call.
			 */
			void RecordWork(std::int64_t microseconds) noexcept;

			/**
			 * @brief Writes the work timing summary to the logger.
			 */
			void DumpWork() noexcept;

			/**
			 * @brief Whether this node is a ProcessTwoPasses leaf in Measure.
			 * @return true only on that derived type while measuring.
			 *
			 * Friend of @ref ProcessTwoPasses. Not part of the leaf API.
			 */
			bool MeasuringTwoPass() const noexcept;

			std::shared_ptr<StormByte::Logger::Log> m_log;		///< Scoped module logger
			std::string m_name;									///< Leaf name
			Pipeline::Kinds m_receives;							///< Receives
			Pipeline::Kinds m_produces;							///< Produces

		private:
			std::condition_variable m_wake;						///< Single consumer CV
			std::unique_ptr<Backend::Pipeline::Pipe> m_pipe;	///< In / out hoppers

		protected:
			/**
			 * @brief In / out hoppers of this filter.
			 * @return The composed Pipe.
			 */
			Backend::Pipeline::Pipe& pipe() noexcept;

			/**
			 * @brief In / out hoppers of this filter.
			 * @return The composed Pipe.
			 */
			const Backend::Pipeline::Pipe& pipe() const noexcept;

			std::shared_ptr<Pipeline::StageTelemetry> m_telemetry;	///< Counters retained by job snapshots
			std::unique_ptr<Surface> m_surface;						///< Host for Pumper and Worker
			std::unique_ptr<Backend::Pipeline::Pumper> m_pumper;	///< Thread and State
			std::mutex m_wait;										///< Mutex for m_wake
			std::optional<std::string> m_error;						///< Fail message
			bool m_exhausted;										///< Source Ended(); unused on Through
			std::uint64_t m_workN;									///< Timed Process calls
			std::int64_t m_workMin;									///< Fastest Process, us
			std::int64_t m_workMax;									///< Slowest Process, us
			std::int64_t m_lastWork;								///< Last Process, us
			Pipeline::Item::PointerType m_current;					///< Unit of this Work call
			std::deque<Pipeline::Item::PointerType> m_queue;		///< Thread-local Hold
			std::uint8_t m_hold;									///< Ceiling; 0 = not Held
			std::uint8_t m_heldFor;									///< Parked count
			std::shared_ptr<const Pipeline::Plan> m_plan;			///< Job plan; Filters copies it
			int m_origin;											///< Plan track In(); -1 until bound
			/** @endcond */
	};

	/**
	 * @class Process
	 * @brief One-pass filter that mutates decoded frames. May also take packets.
	 *
	 * Inherit this for a video / audio / subtitle filter that
	 * rewrites planes as units arrive (watermark, scale, tonemap,
	 * yadif). The short constructor sets Receives and Produces to
	 * @ref StormByte::Multimedia::Pipeline::Kind::Frame. A leaf that
	 * also handles packets uses the longer constructor.
	 * Implement @ref FFmpeg::Process(const Pipeline::Frame&) and,
	 * if the mask includes Packet,
	 * @ref FFmpeg::Process(const Pipeline::Packet&). Use @ref AVFrame
	 * / @ref AVPacket and @ref Save. Do not declare a method named
	 * Process on this class: that is a constructor.
	 *
	 * A filter that must read the whole origin before it rewrites
	 * inherits @ref ProcessTwoPasses, which is still a Process.
	 * @ref Filters sees the derived type and runs a measure pass
	 * on that track only. Remux plus ProcessTwoPasses is Fail at
	 * wire time.
	 *
	 * @ingroup multimedia_pipeline
	 */
	class STORMBYTE_MULTIMEDIA_PUBLIC Process: public FFmpeg {
		public:
			/**
			 * @brief Copy is not allowed. The tube owns the mounted leaf.
			 */
			Process(const Process& other) = delete;

			/**
			 * @brief Move is not allowed. The tube owns the mounted leaf.
			 */
			Process(Process&& other) noexcept = delete;

			/**
			 * @brief Releases only filter resources. Does not Halt.
			 */
			~Process() noexcept override = default;

			/**
			 * @brief Copy assignment is not allowed.
			 */
			Process& operator=(const Process& other) = delete;

			/**
			 * @brief Move assignment is not allowed.
			 */
			Process& operator=(Process&& other) noexcept = delete;

		protected:
			/**
			 * @brief Named process node. Frame to Frame.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 */
			Process(std::shared_ptr<StormByte::Logger::Log> log, std::string name) noexcept;

			/**
			 * @brief Named process node with an explicit mask.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 * @param receives Kinds this leaf consumes.
			 * @param produces Kinds this leaf emits.
			 */
			Process(std::shared_ptr<StormByte::Logger::Log> log, std::string name,
				Pipeline::Kinds receives, Pipeline::Kinds produces) noexcept;
	};

	/**
	 * @class ProcessTwoPasses
	 * @brief Process that measures the origin before it rewrites.
	 *
	 * Inherit this when the rewrite needs a first look at every
	 * origin frame (loudnorm). Implement @ref Measure and
	 * @ref Process. @ref Measured runs once after measure EoF.
	 *
	 * The short constructor is Frame to Frame, same as Process.
	 *
	 * @ingroup multimedia_pipeline
	 */
	class STORMBYTE_MULTIMEDIA_PUBLIC ProcessTwoPasses: public Process {
		friend class StormByte::Multimedia::Pipeline::Filters;
		friend class FFmpeg;

		public:
			/**
			 * @brief Copy is not allowed. The tube owns the mounted leaf.
			 */
			ProcessTwoPasses(const ProcessTwoPasses& other) = delete;

			/**
			 * @brief Move is not allowed. The tube owns the mounted leaf.
			 */
			ProcessTwoPasses(ProcessTwoPasses&& other) noexcept = delete;

			/**
			 * @brief Releases only filter resources. Does not Halt.
			 */
			~ProcessTwoPasses() noexcept override = default;

			/**
			 * @brief Copy assignment is not allowed.
			 */
			ProcessTwoPasses& operator=(const ProcessTwoPasses& other) = delete;

			/**
			 * @brief Move assignment is not allowed.
			 */
			ProcessTwoPasses& operator=(ProcessTwoPasses&& other) noexcept = delete;

		protected:
			/**
			 * @brief Named two-pass process. Frame to Frame.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 */
			ProcessTwoPasses(std::shared_ptr<StormByte::Logger::Log> log, std::string name) noexcept;

			/**
			 * @brief Named two-pass process with an explicit mask.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 * @param receives Kinds this leaf consumes.
			 * @param produces Kinds this leaf emits.
			 */
			ProcessTwoPasses(std::shared_ptr<StormByte::Logger::Log> log, std::string name,
				Pipeline::Kinds receives, Pipeline::Kinds produces) noexcept;

			/**
			 * @brief Whether the tube is in the measure pass.
			 * @return true until @ref Measured.
			 *
			 * Available to the derived filter during processing.
			 */
			bool Measuring() const noexcept;

			/**
			 * @brief First pass. Observe only. Do not @ref Save.
			 * @param frame Origin frame. Never null.
			 */
			virtual void Measure(const Pipeline::Frame& frame) noexcept = 0;

			/**
			 * @brief After measure EoF, before the second read.
			 *
			 * Default no-op. Commit measured state here. Then
			 * @ref Process runs as on a one-pass @ref Process leaf.
			 * @ref Clean is not called between passes.
			 */
			virtual void Measured() noexcept;

		private:
			/**
			 * @brief Friend-only. Enter the measure pass.
			 */
			void EnterMeasure() noexcept;

			/**
			 * @brief Friend-only. Leave measure and call @ref Measured.
			 */
			void LeaveMeasure() noexcept;

			/**
			 * @brief Friend-only. Facade that owns this measure pass.
			 * @param owner Filters facade. May be null.
			 */
			void BindMeasure(StormByte::Multimedia::Pipeline::Filters* owner) noexcept;

			/**
			 * @brief Friend-only. Origin of this leaf has no more measure units.
			 *
			 * Sets @ref m_measureClosed. That flag stays true until
			 * @ref EnterMeasure or @ref LeaveMeasure. Wakes Wait.
			 * Does not drain.
			 */
			void MeasureSourceClosed() noexcept;

			/**
			 * @brief Friend-only. Hopper empty after measure source closed.
			 *
			 * CAS on @ref m_measureDrained once, then
			 * @ref Filters::OnMeasureFilterDrained.
			 */
			void DrainMeasure() noexcept;

			bool m_measuring = false;	///< First pass
			std::atomic<bool> m_measureClosed{false};	///< Origin will not send more measure units
			std::atomic<bool> m_measureDrained{false};	///< OnMeasureFilterDrained already ran
			StormByte::Multimedia::Pipeline::Filters* m_measureOwner = nullptr;	///< Facade for drain
	};

	/**
	 * @class Packet
	 * @brief Mutates compressed packets.
	 *
	 * Inherit this for a bitstream filter. The short constructor
	 * sets Receives and Produces to
	 * @ref StormByte::Multimedia::Pipeline::Kind::Packet.
	 */
	class STORMBYTE_MULTIMEDIA_PUBLIC Packet: public FFmpeg {
		public:
			/**
			 * @brief Copy is not allowed. The tube owns the mounted leaf.
			 */
			Packet(const Packet& other) = delete;

			/**
			 * @brief Move is not allowed. The tube owns the mounted leaf.
			 */
			Packet(Packet&& other) noexcept = delete;

			/**
			 * @brief Releases filter resources; the job manages worker shutdown.
			 */
			~Packet() noexcept override = default;

			/**
			 * @brief Copy assignment is not allowed.
			 */
			Packet& operator=(const Packet& other) = delete;

			/**
			 * @brief Move assignment is not allowed.
			 */
			Packet& operator=(Packet&& other) noexcept = delete;

		protected:
			/**
			 * @brief Named packet node. Packet to Packet.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 */
			Packet(std::shared_ptr<StormByte::Logger::Log> log, std::string name) noexcept;

			/**
			 * @brief Named packet node with an explicit mask.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 * @param receives Kinds this leaf consumes.
			 * @param produces Kinds this leaf emits.
			 */
			Packet(std::shared_ptr<StormByte::Logger::Log> log, std::string name,
				Pipeline::Kinds receives, Pipeline::Kinds produces) noexcept;
	};

	/**
	 * @class Analytics
	 * @brief Measures units. Does not rewrite them.
	 *
	 * Inherit this to observe decoded frames (VMAF, PSNR).
	 * The filter does not open a decoder and does not see packets.
	 *
	 * Implement @ref Process(const Pipeline::Frame&) only.
	 * @ref StormByte::Multimedia::Pipeline::Item::Producer is
	 * Decoder on the reference look and Encoder or Remuxer on
	 * the distorted look. Pair them in presentation order per
	 * @ref Pipeline::Frame::Track. Do not Hold: both looks
	 * arrive on the same Process and a Hold would mix them.
	 *
	 * The short constructor Receives Frame and Produces Frame.
	 *
	 * @ref Save, @ref Hold, @ref Release, @ref Held and
	 * @ref HeldFor are deleted: an analytics leaf must not
	 * rewrite units and must not park a mixed pair of looks.
	 * @ref LastChance is an unused no-op override. It cannot
	 * be deleted: the worker may still dispatch it if a Hold
	 * path ran. @ref Eof, @ref Clean, @ref Setup and
	 * @ref Report remain. A low score is not Fail.
	 *
	 * There is no method named Analytics on this class: that
	 * would be a constructor.
	 */
	class STORMBYTE_MULTIMEDIA_PUBLIC Analytics: public FFmpeg {
		public:
			/**
			 * @brief Copy is not allowed. The tube owns the mounted leaf.
			 */
			Analytics(const Analytics& other) = delete;

			/**
			 * @brief Move is not allowed. The tube owns the mounted leaf.
			 */
			Analytics(Analytics&& other) noexcept = delete;

			/**
			 * @brief Releases only filter resources. Does not Halt.
			 */
			~Analytics() noexcept override = default;

			/**
			 * @brief Copy assignment is not allowed.
			 */
			Analytics& operator=(const Analytics& other) = delete;

			/**
			 * @brief Move assignment is not allowed.
			 */
			Analytics& operator=(Analytics&& other) noexcept = delete;

		protected:
			/**
			 * @brief Named analytics node.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 *
			 * Receives Frame. Produces Frame.
			 */
			Analytics(std::shared_ptr<StormByte::Logger::Log> log, std::string name) noexcept;

			/**
			 * @brief Named analytics node with an explicit mask.
			 * @param log Shared logger. Empty pointer means no log.
			 * @param name Short leaf name.
			 * @param receives Kinds this leaf consumes.
			 * @param produces Kinds this leaf emits.
			 */
			Analytics(std::shared_ptr<StormByte::Logger::Log> log, std::string name,
				Pipeline::Kinds receives, Pipeline::Kinds produces) noexcept;

			/**
			 * @brief Deleted. Analytics must not rewrite the current frame.
			 * @param incoming Ignored.
			 */
			void Save(StormByte::Multimedia::FFmpeg::AVFrame&& incoming) noexcept = delete;

			/**
			 * @brief Deleted. Analytics never sees packets and must not rewrite them.
			 * @param incoming Ignored.
			 */
			void Save(StormByte::Multimedia::FFmpeg::AVPacket&& incoming) noexcept = delete;

			/**
			 * @brief Deleted. Holding would mix reference and distorted looks.
			 * @param n Ignored.
			 */
			void Hold(std::uint8_t n) noexcept = delete;

			/**
			 * @brief Deleted. There is no Hold on Analytics.
			 */
			void Release() noexcept = delete;

			/**
			 * @brief Deleted. There is no Hold on Analytics.
			 */
			bool Held() const noexcept = delete;

			/**
			 * @brief Deleted. There is no Hold on Analytics.
			 */
			std::uint8_t HeldFor() const noexcept = delete;

			/**
			 * @brief Unused on Analytics. Hold is not allowed here.
			 * @param frame Ignored.
			 */
			void LastChance(const Pipeline::Frame& frame) noexcept override {
				(void)frame;
			}

			/**
			 * @brief Unused on Analytics. Packets never arrive here.
			 * @param packet Ignored.
			 */
			void LastChance(const Pipeline::Packet& packet) noexcept override {
				(void)packet;
			}
	};
}
