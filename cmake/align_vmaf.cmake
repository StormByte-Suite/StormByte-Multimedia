if((WITH_FFMPEG STREQUAL "SYSTEM" OR WITH_FFMPEG STREQUAL "BUNDLED")
	AND NOT WITH_VMAF STREQUAL WITH_FFMPEG)
	message(STATUS "Overriding WITH_VMAF=${WITH_VMAF} with ${WITH_FFMPEG} to match WITH_FFMPEG and avoid mixing dependency ABIs")
	set(WITH_VMAF "${WITH_FFMPEG}" CACHE STRING "Use VMAF libraries (SYSTEM or BUNDLED)" FORCE)
	set(WITH_VMAF "${WITH_FFMPEG}")
endif()