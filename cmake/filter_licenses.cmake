set(STORMBYTE_MULTIMEDIA_GPL_FILTERS
	audio/rubberband
	video/vaguedenoiser
)
set(STORMBYTE_MULTIMEDIA_NONFREE_FILTERS "")

set(STORMBYTE_MULTIMEDIA_DISABLED_FILTERS "")
if(NOT WITH_GPL)
	list(APPEND STORMBYTE_MULTIMEDIA_DISABLED_FILTERS ${STORMBYTE_MULTIMEDIA_GPL_FILTERS})
